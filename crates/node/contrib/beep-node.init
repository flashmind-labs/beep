#!/bin/sh
### BEGIN INIT INFO
# Provides:          beep-node
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Beep node
### END INIT INFO
#
# The Beep node as a SysV init service. `beep-node service install` writes
# this to /etc/init.d/beep-node with its own command, arguments and PATH.
# SysV init does not restart the node when it exits.

# Read with eval, as OpenRC reads them, so each holds shell-quoted words.
command=@COMMAND@
command_args=@ARGS@
PATH=@PATH@:/sbin:/usr/sbin:/bin:/usr/bin
export PATH

pidfile=/var/run/beep-node.pid
output_log=/var/log/beep-node.log

running() {
	[ -f "$pidfile" ] || return 1
	pid=$(cat "$pidfile" 2>/dev/null)
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

do_start() {
	if running; then
		echo "beep-node is already running"
		return 0
	fi
	echo "Starting beep-node"
	# Its own session, so a closing terminal does not stop it.
	detach=
	command -v setsid >/dev/null 2>&1 && detach=setsid
	(eval "exec $detach $command $command_args") </dev/null >>"$output_log" 2>&1 &
	echo $! >"$pidfile"
}

do_stop() {
	if ! running; then
		echo "beep-node is not running"
		rm -f "$pidfile"
		return 0
	fi
	echo "Stopping beep-node"
	# TERM to the node alone, so it closes its agent sessions itself.
	kill "$pid"
	i=0
	while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 20 ]; do
		sleep 1
		i=$((i + 1))
	done
	if kill -0 "$pid" 2>/dev/null; then
		kill -9 "$pid"
	fi
	rm -f "$pidfile"
}

case "$1" in
start)
	do_start
	;;
stop)
	do_stop
	;;
restart | force-reload)
	do_stop
	do_start
	;;
status)
	if running; then
		echo "beep-node is running (pid $pid)"
		exit 0
	fi
	echo "beep-node is not running"
	exit 3
	;;
*)
	echo "Usage: $0 {start|stop|restart|force-reload|status}" >&2
	exit 3
	;;
esac
