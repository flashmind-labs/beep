{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beep",
  "identifier": "com.flashmind.beep.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "bar",
        "title": "Beep",
        "width": 680,
        "height": 64,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "dragDropEnabled": false,
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "active",
          "radius": 18
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4RkVCMkU1QkI5N0VDRUIKUldUcjdKZTc1YkwraUJnYWY0YmVpSW8vZlZXV0U1aDN4SllyR3YxRUdQQThOZ1ZYMDZZdTYrTzAK",
      "endpoints": [
        "https://releases.flashmind.com/beep/macos/latest.json"
      ]
    }
  }
}
