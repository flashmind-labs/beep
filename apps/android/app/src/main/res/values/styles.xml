<resources>
    <string name="widget_description">Quick access to Beep assistant</string>
    <string name="cover_widget_description">Ask Beep from the cover screen</string>
    <style name="Theme.Beep" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#2F8A69</item>
        <item name="android:statusBarColor">#F4F8F5</item>
        <item name="android:navigationBarColor">#F4F8F5</item>
    </style>
    <style name="Theme.Beep.Translucent" parent="android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- The floating head's chat: a dialog-sized window that closes on an outside tap. -->
    <style name="Theme.Beep.Panel" parent="Theme.Beep">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.25</item>
        <item name="android:windowAnimationStyle">@style/Animation.Beep.Panel</item>
    </style>
    <style name="Animation.Beep.Panel" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/panel_enter</item>
        <item name="android:windowExitAnimation">@anim/panel_exit</item>
    </style>
</resources>
