<?xml version="1.0" encoding="utf-8"?>
<!-- The Flex Window widget on a flip phone's cover screen. Tapping anywhere opens Beep there. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cover_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8F5"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_beep"
        android:importantForAccessibility="no" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Beep"
        android:textColor="#10201A"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/cover_widget_pill"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="Ask Beep"
        android:textColor="#5C6E64"
        android:textSize="15sp" />
</LinearLayout>
