#!/usr/bin/env python3
"""Module dependency graphs: find cycles, check a branch adds none, draw graphs.

  depgraph scan <root> [--tree PATH]... [--depth N] [--cuts N] [--json OUT] [--draw OUT.html] [--all]
      Reads every Rust crate (src/ beside a Cargo.toml), TypeScript or JavaScript
      tree (src/ beside a package.json) and Python package under <root>, or only
      the given --tree paths. Prints each tree's cycle groups, the imports that
      tie each group and the fewest imports to cut to break it. --json writes the
      graph in the draw format. --draw draws the modules in cycles (--all: every
      module) top to bottom.

  depgraph diff <base checkout> <branch checkout> [--tree PATH]... [--depth N]
      The cycles the branch adds over the base and the imports that close them.
      Exit code 1 when it adds one.

  depgraph draw <graph.json> <out.html> [--title TEXT]
      Draws any graph top to bottom: an entity sits above what it acts on, a
      chain stacks in one column, and the edges that close a cycle run upward,
      outlined in red. Input:
        {"title": "...",
         "nodes": [{"id": "A1", "name": "Session store", "group": "node",
                    "kind": "actor|store|lock|module|stateless", "note": "..."}],
         "edges": [{"from": "A1", "to": "B2", "kind": "push|ping|ask|order|owns|import",
                    "label": "what flows (file:line)", "cut": false}]}
      "cut": true draws the edge as a proposed cut.
      Layout uses elkjs, installed with npm into ~/.cache/depgraph on first use.

  depgraph structs <root> [--tree PATH]... [--json OUT] [--draw OUT.html]
      The struct level under scan. Nodes are the long-lived structs (Rust: shared
      through Arc or Weak, or holding a lock, channel, task set or hub) and fns that
      serve a node, or the stores of the frontend (`*-state.ts`, `create*Store`) with
      a `native` node for invoke and listen. Edges: owns (a field), ask and order
      (`self.field.method()` that returns a value or only sequences), push (send,
      publish, notify, store subscription). Prints the cycle groups on owns, ask and
      order with the fewest cuts, the pushes that close a cycle upward, and state of
      one type and name kept in two nodes. Callbacks, `Box<dyn Fn>`, trait objects
      and reply channels are not seen.

  depgraph timers <root> [--allow .timers] [--write] [--check] [--base CHECKOUT] [--json OUT]
      Every timer and sleep outside tests, checked against the allow file at
      <root>: `path | function | call#n | kind | reason`, kind one of poll,
      retry, debounce, deadline, outside, ui, pace, compat. --write adds new timers as
      `?` and drops stale ones. --check exits 1 on a timer with no kind, and with
      --base on a poll the base checkout did not have.

scan and diff check two levels: areas (top folders or modules) and files.
--depth N checks one level, grouping N path segments deep (Python is per file).
A Rust parent and its children count like any two modules; a `pub use`
re-export is naming, so a path through it counts toward the defining module.
Dynamic `import()` counts: a lazy import still closes a cycle at run time.
Type-only TypeScript imports, Rust tests and `#[cfg(test)]` code are left
out. Callbacks, slots and registries that call back up are invisible here:
look for them by hand.
"""
import argparse, html, json, os, re, subprocess, sys
from pathlib import Path

SKIP = {"target", "node_modules", ".git", ".worktrees", "dist", "build", "gen", "__pycache__", ".venv", "venv"}


# ---------- reading imports ----------

def walk(root: Path, pattern: str):
    for dirpath, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if d not in SKIP and not d.startswith(".")]
        for f in files:
            if Path(f).match(pattern):
                yield Path(dirpath) / f


def expand(tree: str):
    """`a::{b, c::{d, e}}` as flat paths."""
    tree = tree.strip()
    at = tree.find("{")
    if at < 0:
        return [tree.split(" as ")[0].strip()] if tree else []
    depth, end = 0, len(tree)
    for i in range(at, len(tree)):
        depth += tree[i] == "{"
        depth -= tree[i] == "}"
        if depth == 0:
            end = i
            break
    parts, depth, start = [], 0, at + 1
    for i in range(at + 1, end):
        depth += tree[i] == "{"
        depth -= tree[i] == "}"
        if tree[i] == "," and depth == 0:
            parts.append(tree[start:i])
            start = i + 1
    parts.append(tree[start:end])
    return [tree[:at] + path for part in parts for path in expand(part)]


def rust_module(root: Path, f: Path):
    parts = list(f.relative_to(root).with_suffix("").parts)
    if parts and parts[-1] in ("mod", "lib", "main"):
        parts.pop()
    return tuple(parts)


RUST_PATH = r"(?<![\w:])(?:crate|self|(?:super::)*super|[a-z_][a-z0-9_]*)(?:::[A-Za-z_][A-Za-z0-9_]*)+"
REEXPORT = r"\bpub(?:\([^)]*\))?\s+use\s+([^;]+);"


def rust_resolve(path: str, here: tuple, mods: set, reexports: dict):
    """The module a path names, following `pub use` re-exports to where an item lives."""
    names = [n.strip() for n in path.split(" as ")[0].split("::")]
    if names[0] == "crate":
        at, tail = (), names[1:]
    elif names[0] == "super":
        ups = len([n for n in names if n == "super"])
        at, tail = here[: max(0, len(here) - ups)], names[ups:]
    elif names[0] == "self":
        at, tail = here, names[1:]
    elif here + (names[0],) in mods:
        at, tail = here, names
    else:
        return None
    for name in tail:
        if at + (name,) in mods:
            at += (name,)
        elif name in reexports.get(at, {}):
            at = reexports[at][name]
        else:
            break
    return at


OPENERS, CLOSERS = "([{", ")]}"
CFG_START = re.compile(r"#\[\s*cfg\s*\(")
ITEM_WORD = re.compile(r"(?:pub(?:\([^)]*\))?\s+)?(?:fn|impl|struct|enum|mod|trait|use|const|static|type|unsafe|async|extern|union|macro_rules)\b")


def top_level_args(pred: str):
    args, depth, cur = [], 0, ""
    for ch in pred:
        depth += (ch in OPENERS) - (ch in CLOSERS)
        if ch == "," and depth == 0:
            args.append(cur.strip())
            cur = ""
        else:
            cur += ch
    return args + [cur.strip()]


def requires_test(pred: str):
    """True for `test` and `all(test, ..)`: test is a positive requirement. Not `not`, `any`, features."""
    pred = pred.strip()
    m = re.fullmatch(r"all\s*\((.*)\)", pred, re.S)
    return pred == "test" or bool(m and "test" in top_level_args(m.group(1)))


def skip_lexeme(text: str, i: int):
    """The end of the string, char or comment starting at i, or None when none starts there."""
    n = len(text)
    if text.startswith("//", i):
        j = text.find("\n", i)
        return n if j < 0 else j
    if text.startswith("/*", i):
        depth, j = 1, i + 2
        while j < n and depth:
            if text.startswith("/*", j):
                depth, j = depth + 1, j + 2
            elif text.startswith("*/", j):
                depth, j = depth - 1, j + 2
            else:
                j += 1
        return j
    m = re.compile(r'b?r(#*)"').match(text, i)
    if m:
        j = text.find('"' + m.group(1), m.end())
        return n if j < 0 else j + 1 + len(m.group(1))
    if text[i] == '"':
        j = i + 1
        while j < n and text[j] != '"':
            j += 2 if text[j] == "\\" else 1
        return j + 1
    m = re.compile(r"'(?:\\.[^']*|[^\\'])'").match(text, i)
    return m.end() if m else None


def cfg_test_item_end(text: str, i: int):
    """The end of the item (or field, variant, arm) starting at i: past its `;`, past the `}` of its
    first top-level block, or at a top-level `,` or an enclosing closer (neither consumed)."""
    comma_ends = not ITEM_WORD.match(text, i)
    depth, j, n = 0, i, len(text)
    while j < n:
        end = skip_lexeme(text, j)
        if end is not None:
            j = end
            continue
        c = text[j]
        if c in CLOSERS and depth == 0:
            return j
        if c == "," and depth == 0 and comma_ends:
            return j
        j += 1
        if c in OPENERS:
            depth += 1
        elif c in CLOSERS:
            depth -= 1
            if c == "}" and depth == 0:
                return j
        elif c == ";" and depth == 0:
            return j
    return n


def without_cfg_test(text: str):
    """The text with each `#[cfg(test)]` or `#[cfg(all(test, ..))]` item blanked, newlines kept,
    so a test-only item hides itself and nothing after it. Markers in comments and strings are ignored."""
    out, last, i, n = [], 0, 0, len(text)
    while i < n:
        end = skip_lexeme(text, i)
        if end is not None:
            i = end
            continue
        m = CFG_START.match(text, i)
        if not m:
            i += 1
            continue
        close = cfg_close(text, m.end())
        if close is None or not text.startswith("]", close):
            i = m.end()
            continue
        pred, i2 = text[m.end(): close - 1], close + 1
        if not requires_test(pred):
            i = i2
            continue
        while i2 < n:
            ws = re.compile(r"\s*").match(text, i2).end()
            if text.startswith("#[", ws):
                i2 = skip_brackets(text, ws + 2)
            elif text.startswith("//", ws) or text.startswith("/*", ws):
                i2 = skip_lexeme(text, ws)
            else:
                i2 = ws
                break
        stop = cfg_test_item_end(text, i2)
        out += [text[last:i], re.sub(r"[^\n]", " ", text[i:stop])]
        last = i = stop
    return "".join(out) + text[last:]


def skip_brackets(text: str, i: int):
    """The index past the `]` closing the `[` just before i."""
    depth = 1
    while i < len(text) and depth:
        end = skip_lexeme(text, i)
        if end is not None:
            i = end
            continue
        depth += (text[i] == "[") - (text[i] == "]")
        i += 1
    return i


def cfg_close(text: str, i: int):
    """The index just past the `)` closing the `(` before i, or None."""
    depth = 1
    while i < len(text):
        end = skip_lexeme(text, i)
        if end is not None:
            i = end
            continue
        depth += (text[i] == "(") - (text[i] == ")")
        i += 1
        if depth == 0:
            return i
    return None


def rust_edges(root: Path, depth: int):
    """Imports between modules, parent and child included. A `pub use` is naming, not use:
    it adds no edge, and a path through it counts toward the module that defines the item."""
    files = [f for f in walk(root, "*.rs") if "tests" not in f.relative_to(root).parts]
    mods = {rust_module(root, f) for f in files}
    texts = {}
    for f in files:
        text = re.sub(r"//[^\n]*", "", without_cfg_test(f.read_text(errors="replace")))
        text = re.sub(r"\bpub\(in [^)]*\)", "pub", text)
        texts[rust_module(root, f)] = text
    reexports = {}
    for _ in range(3):
        for here, text in texts.items():
            for m in re.finditer(REEXPORT, text):
                for path in expand(re.sub(r"\s+", " ", m.group(1))):
                    item = path.split(" as ")[-1].split("::")[-1].strip()
                    to = rust_resolve(path.rsplit("::", 1)[0] if "::" in path else path, here, mods, reexports)
                    if to and to != here and item not in ("*", "self"):
                        reexports.setdefault(here, {})[item] = to
    edges = set()
    for here, text in texts.items():
        text = re.sub(REEXPORT, "", text)
        paths = []
        for m in re.finditer(r"\buse\s+([^;]+);", text):
            paths += expand(re.sub(r"\s+", " ", m.group(1)))
        text = re.sub(r"\buse\s+[^;]+;", "", text)
        paths += [m.group(0) for m in re.finditer(RUST_PATH, text)]
        for path in paths:
            at = rust_resolve(path, here, mods, reexports)
            if at is None:
                continue
            a, b = here[:depth], at[:depth]
            if a and b and a != b:
                edges.add(("::".join(a), "::".join(b)))
    return edges


TS_EXT = (".ts", ".tsx", ".mts", ".js", ".jsx", ".mjs")


def ts_edges(root: Path, depth: int):
    files = {f.resolve() for ext in TS_EXT for f in walk(root, "*" + ext) if not f.name.endswith(".d.ts")}
    base = root.resolve()
    edges = set()
    pattern = (r"^\s*(?:import|export)\s+(?!type\b)[^;]*?from\s+[\"'](\.[^\"']+)[\"']|^\s*import\s+[\"'](\.[^\"']+)[\"']"
               r"|\bimport\(\s*[\"'](\.[^\"']+)[\"']\s*\)")

    def unit(path: Path):
        parts = path.relative_to(base).parts
        return "/".join(parts[:depth]) if len(parts) > depth else "/".join(parts)

    for f in files:
        for m in re.finditer(pattern, f.read_text(errors="replace"), re.M | re.S):
            target = (f.parent / (m.group(1) or m.group(2) or m.group(3))).resolve()
            stem = target.with_suffix("") if target.suffix in (".js", ".mjs", ".jsx") else target
            cands = [target] + [Path(str(stem) + e) for e in TS_EXT] + [target / ("index" + e) for e in TS_EXT]
            for c in cands:
                if c in files and c != f:
                    if unit(f) != unit(c):
                        edges.add((unit(f), unit(c)))
                    break
    return edges


def py_edges(root: Path, _depth: int):
    files = [f for f in walk(root, "*.py")]
    mods = {}
    for f in files:
        parts = list(f.relative_to(root).with_suffix("").parts)
        if parts[-1] == "__init__":
            parts.pop()
        if parts:
            mods[".".join(parts)] = f
    edges = set()
    for name, f in mods.items():
        pkg = name.split(".") if f.name == "__init__.py" else name.split(".")[:-1]
        text = f.read_text(errors="replace")
        targets = []
        for m in re.finditer(r"^\s*from\s+(\.*)([\w.]*)\s+import\s+([^\n#]+)", text, re.M):
            dots, mod, names = m.groups()
            if dots:
                head = pkg[: len(pkg) - (len(dots) - 1)] if len(dots) > 1 else pkg
                full = ".".join(head + ([mod] if mod else []))
            else:
                full = mod
            targets.append(full)
            targets += [f"{full}.{n.strip().split(' as ')[0]}" for n in names.strip("()").split(",") if n.strip()]
        for m in re.finditer(r"^\s*import\s+([\w.]+)", text, re.M):
            targets.append(m.group(1))
        for t in targets:
            while t and t not in mods:
                t = t.rpartition(".")[0]
            if t and t != name and not name.startswith(t + "."):
                edges.add((name, t))
    return edges


READERS = {"rust": rust_edges, "ts": ts_edges, "py": py_edges}


def find_trees(root: Path):
    trees = []
    for cargo in walk(root, "Cargo.toml"):
        if (cargo.parent / "src").is_dir():
            trees.append(("rust", cargo.parent / "src"))
    for pkg in walk(root, "package.json"):
        src = pkg.parent / "src"
        if src.is_dir() and any(True for e in TS_EXT for _ in walk(src, "*" + e)):
            trees.append(("ts", src))
    rust_ts = {t for _, t in trees}
    for init in walk(root, "__init__.py"):
        top = init.parent
        if (top.parent / "__init__.py").exists() or any(top.is_relative_to(t) for t in rust_ts):
            continue
        trees.append(("py", top.parent if top.parent != root else top))
    seen, out = set(), []
    for lang, t in trees:
        if t not in seen:
            seen.add(t)
            out.append((lang, t))
    return out


def tree_lang(path: Path):
    if any(True for _ in walk(path, "*.rs")):
        return "rust"
    if any(True for e in TS_EXT for _ in walk(path, "*" + e)):
        return "ts"
    return "py"


# ---------- cycles ----------

def components(edges):
    graph = {}
    for a, b in edges:
        graph.setdefault(a, []).append(b)
        graph.setdefault(b, [])
    index, low, on, stack, comp, n = {}, {}, set(), [], {}, 0
    for start in graph:
        if start in index:
            continue
        work = [(start, iter(graph[start]))]
        index[start] = low[start] = n; n += 1; stack.append(start); on.add(start)
        while work:
            v, it = work[-1]
            w = next(it, None)
            if w is not None:
                if w not in index:
                    index[w] = low[w] = n; n += 1; stack.append(w); on.add(w)
                    work.append((w, iter(graph[w])))
                elif w in on:
                    low[v] = min(low[v], index[w])
                continue
            work.pop()
            if work:
                low[work[-1][0]] = min(low[work[-1][0]], low[v])
            if low[v] == index[v]:
                group = []
                while True:
                    w = stack.pop(); on.discard(w); group.append(w)
                    if w == v:
                        break
                members = frozenset(group)
                for w in group:
                    comp[w] = members
    return comp


def groups(edges):
    return sorted({g for g in components(edges).values() if len(g) > 1}, key=len, reverse=True)


def in_cycles(edges):
    return sum(len(g) for g in groups(edges))


def cuts(edges, limit):
    """Greedy: the import whose removal frees the most modules, repeated."""
    edges, out, cur = set(edges), [], in_cycles(edges)
    for _ in range(limit):
        comp = components(edges)
        inside = [e for e in edges if len(comp[e[0]]) > 1 and comp[e[0]] is comp[e[1]]]
        if not inside:
            break
        best = min(inside, key=lambda e: in_cycles(edges - {e}))
        after = in_cycles(edges - {best})
        if after >= cur:
            break
        edges.discard(best)
        out.append((best, cur, after))
        cur = after
    return out


# ---------- commands ----------

def selected(root: Path, trees):
    if trees:
        return [(tree_lang(root / t), root / t) for t in trees]
    return find_trees(root)


LEVELS = {"areas": 1, "files": 99}


def levels(args):
    return [(f"depth {args.depth}", args.depth)] if args.depth else list(LEVELS.items())


def scan(args):
    root = Path(args.root).resolve()
    graph = dict(title=f"Module cycles in {root.name}", nodes=[], edges=[])
    for n, (level, depth) in enumerate(levels(args)):
        for lang, tree in selected(root, args.tree):
            edges = READERS[lang](tree, depth)
            gs = groups(edges)
            rel = tree.relative_to(root).as_posix() if tree != root else "."
            print(f"{rel} ({lang}, {level}): {len({x for e in edges for x in e})} modules, {len(edges)} imports, "
                  f"{sum(len(g) for g in gs)} modules in {len(gs)} cycle groups")
            for g in gs:
                print(f"  group of {len(g)}: {', '.join(sorted(g)[:12])}{' ...' if len(g) > 12 else ''}")
            cut = set()
            if gs and args.cuts:
                for (a, b), before, after in cuts(edges, args.cuts):
                    cut.add((a, b))
                    print(f"  cut {a} -> {b}: {before} -> {after} modules in cycles")
            if n:
                continue
            keep = {x for g in gs for x in g} if not args.all else {x for e in edges for x in e}
            for m in sorted(keep):
                graph["nodes"].append(dict(id=f"{rel}:{m}", name=m, group=rel, kind="module", note=""))
            for a, b in sorted(edges):
                if a in keep and b in keep:
                    graph["edges"].append({"from": f"{rel}:{a}", "to": f"{rel}:{b}", "kind": "import", "label": "", "cut": (a, b) in cut})
    if args.json:
        Path(args.json).write_text(json.dumps(graph, indent=1))
    if args.draw:
        draw_graph(graph, Path(args.draw))
    return 0


def diff(args):
    base, branch = Path(args.base).resolve(), Path(args.branch).resolve()
    bad = False
    for level, depth in levels(args):
        for lang, tree in selected(branch, args.tree):
            rel = tree.relative_to(branch)
            old = READERS[lang](base / rel, depth) if (base / rel).is_dir() else set()
            new = READERS[lang](tree, depth)
            was, now = components(old), components(new)
            added = sorted(new - old)
            tying = [(a, b) for a, b in added if len(now[a]) > 1 and now[a] is now[b]
                     and (a not in was or b not in was or was[a] is not was[b])]
            print(f"{rel.as_posix()} ({level}): {in_cycles(old)} modules in cycles before, {in_cycles(new)} now, {len(added)} imports added")
            for a, b in tying:
                bad = True
                print(f"  NEW CYCLE: {a} -> {b} (group of {len(now[a])})")
    return 1 if bad else 0


LAYOUT_JS = r"""
const ELK = (await import(process.argv[2])).default;
const fs = await import("node:fs");
const g = JSON.parse(fs.readFileSync(0, "utf8"));
const out = await new ELK().layout({
  id: "root",
  layoutOptions: {
    "elk.algorithm": "layered", "elk.direction": "DOWN", "elk.edgeRouting": "SPLINES",
    "elk.layered.spacing.nodeNodeBetweenLayers": "70", "elk.spacing.nodeNode": "28",
    "elk.layered.spacing.edgeNodeBetweenLayers": "18", "elk.spacing.edgeEdge": "8",
    "elk.layered.nodePlacement.strategy": "NETWORK_SIMPLEX",
    "elk.layered.cycleBreaking.strategy": "GREEDY",
    "elk.layered.thoroughness": "40", "elk.spacing.componentComponent": "60",
    ...(g.options || {}),
  },
  children: g.nodes, edges: g.edges,
});
process.stdout.write(JSON.stringify(out));
"""


def elk():
    cache = Path.home() / ".cache" / "depgraph"
    lib = cache / "node_modules" / "elkjs" / "lib" / "elk.bundled.js"
    if not lib.exists():
        cache.mkdir(parents=True, exist_ok=True)
        subprocess.run(["npm", "install", "--silent", "--prefix", str(cache), "elkjs@latest"], check=True)
    script = cache / "layout.mjs"
    if not script.exists() or script.read_text() != LAYOUT_JS:
        script.write_text(LAYOUT_JS)
    return script, lib


KIND_COLOR = {"push": "#4fc38a", "ping": "#e0a93a", "ask": "#e8675a", "order": "#5aa2ef", "owns": "#9aa0a8", "import": "#7f8ea3"}
KIND_DASH = {"ping": "5 4", "owns": "1 4"}
KIND_TEXT = {"push": "sends the value", "ping": "signal, reader then reads", "ask": "request and answer",
             "order": "call that sequences work", "owns": "owns", "import": "imports"}
NODE_COLOR = {"actor": "#4fc38a", "store": "#5aa2ef", "lock": "#e0a93a", "module": "#a98bf0", "stateless": "#6b7079"}
GROUP_TINT = ["#1a1f1c", "#1b1d22", "#211c1b", "#1d1b22", "#1f1e19", "#1a2022"]


def pack_components(laid, edges):
    """Moves each connected part of a laid out graph into shelves of rows, so a graph of many small
    parts is a block that fits a screen and not one long strip. Edge routes move with their part."""
    nodes = {c["id"]: c for c in laid["children"]}
    parent = {i: i for i in nodes}

    def find(i):
        while parent[i] != i:
            parent[i] = parent[parent[i]]
            i = parent[i]
        return i

    for e in edges:
        parent[find(e["from"])] = find(e["to"])
    parts = {}
    for i in nodes:
        parts.setdefault(find(i), []).append(i)
    box = {}
    for root, ids in parts.items():
        box[root] = (min(nodes[i]["x"] for i in ids), min(nodes[i]["y"] for i in ids),
                     max(nodes[i]["x"] + nodes[i]["width"] for i in ids), max(nodes[i]["y"] + nodes[i]["height"] for i in ids))
    gap = 40
    area = sum((b[2] - b[0] + gap) * (b[3] - b[1] + gap) for b in box.values())
    target = max(max(b[2] - b[0] for b in box.values()), (area ** 0.5) * 1.8)
    shift, x, y, row = {}, 0.0, 0.0, 0.0
    for root in sorted(parts, key=lambda r: -(box[r][3] - box[r][1])):
        x0, y0, x1, y1 = box[root]
        if x > 0 and x + (x1 - x0) > target:
            x, y, row = 0.0, y + row + gap, 0.0
        shift[root] = (x - x0, y - y0)
        x, row = x + (x1 - x0) + gap, max(row, y1 - y0)
    for root, ids in parts.items():
        for i in ids:
            nodes[i]["x"] += shift[root][0]
            nodes[i]["y"] += shift[root][1]
    for le, e in zip(laid["edges"], edges):
        dx, dy = shift[find(e["from"])]
        for sec in le.get("sections", []):
            for q in [sec["startPoint"], sec["endPoint"], *sec.get("bendPoints", [])]:
                q["x"] += dx
                q["y"] += dy
    laid["width"] = max(c["x"] + c["width"] for c in nodes.values())
    laid["height"] = max(c["y"] + c["height"] for c in nodes.values())


def draw_graph(graph, out: Path, title=None):
    nodes = graph["nodes"]
    ids = {n["id"] for n in nodes}
    edges = [e for e in graph["edges"] if e["from"] in ids and e["to"] in ids and e["from"] != e["to"]]
    cyc_kinds = set(graph.get("cycle_kinds") or [k for k in KIND_COLOR if k != "owns"])
    comp = components({(e["from"], e["to"]) for e in edges if e.get("kind", "import") in cyc_kinds})
    comp = {k: v for k, v in comp.items()} if "none" not in cyc_kinds else {}
    cyc = lambda a, b: a in comp and len(comp[a]) > 1 and comp[a] is comp.get(b)
    width = 210
    lines = lambda s, n: max(1, -(-len(s.replace("`", "")) // n))
    heights = {n["id"]: 16 + 16 * lines(n.get("name", n["id"]), 26) + (13 * min(4, lines(n["note"], 33)) if n.get("note") else 0) + 18 for n in nodes}
    script, lib = elk()
    request = dict(options=graph.get("layout") or {}, nodes=[dict(id=n["id"], width=width, height=heights[n["id"]]) for n in nodes],
                   edges=[dict(id=f"e{i}", sources=[e["from"]], targets=[e["to"]]) for i, e in enumerate(edges)])
    laid = json.loads(subprocess.run(["node", str(script), str(lib)], input=json.dumps(request), text=True,
                                     capture_output=True, check=True).stdout)
    if graph.get("pack"):
        pack_components(laid, edges)
    pos = {c["id"]: c for c in laid["children"]}
    pad = 20
    gw, gh = laid["width"] + 2 * pad, laid["height"] + 2 * pad
    esc = lambda s: html.escape(str(s))
    tx = lambda s: re.sub(r"`([^`]+)`", r"<code>\1</code>", esc(s))
    tints = {g: GROUP_TINT[i % len(GROUP_TINT)] for i, g in enumerate(dict.fromkeys(n.get("group", "") for n in nodes))}

    def path(sec):
        p = [sec["startPoint"], *sec.get("bendPoints", []), sec["endPoint"]]
        p = [f"{q['x'] + pad:.1f},{q['y'] + pad:.1f}" for q in p]
        if len(p) > 2 and (len(p) - 1) % 3 == 0:
            return f"M{p[0]}" + "".join(f" C{p[i]} {p[i + 1]} {p[i + 2]}" for i in range(1, len(p), 3))
        return "M" + " L".join(p)

    svg = []
    for le, e in zip(laid["edges"], edges):
        k = e.get("kind", "import")
        if not le.get("sections"):
            continue
        up = pos[e["to"]]["y"] < pos[e["from"]]["y"]
        cls = "e" + (" cyc" if up and k in cyc_kinds and cyc(e["from"], e["to"]) else "") + (" cut" if e.get("cut") else "")
        tip = f"{e['from']} to {e['to']}: {k}" + (f", {e['label']}" if e.get("label") else "") + (" (closes a cycle)" if up else "") + (" (suggested cut)" if e.get("cut") else "")
        svg.append(f'<path class="{cls}" data-a="{esc(e["from"])}" data-b="{esc(e["to"])}" d="{path(le["sections"][0])}" '
                   f'stroke="{KIND_COLOR.get(k, "#7f8ea3")}" stroke-dasharray="{"6 4" if e.get("weak") else KIND_DASH.get(k, "")}" marker-end="url(#m-{k})"><title>{esc(tip.replace("`", ""))}</title></path>')
    boxes = []
    for n in nodes:
        p = pos[n["id"]]
        c = " cyc" if n["id"] in comp and len(comp[n["id"]]) > 1 else ""
        boxes.append(f'<div class="n{c}" id="{esc(n["id"])}" style="left:{p["x"] + pad:.0f}px;top:{p["y"] + pad:.0f}px;width:{width}px;height:{p["height"]:.0f}px;'
                     f'border-color:{NODE_COLOR.get(n.get("kind", "module"), "#a98bf0")};background:{tints[n.get("group", "")]}">'
                     f'<i>{esc(n.get("group", ""))}</i><b>{tx(n.get("name", n["id"]))}</b>{f"<span>{tx(n["note"])}</span>" if n.get("note") else ""}</div>')
    kinds = sorted({e.get("kind", "import") for e in edges}, key=list(KIND_COLOR).index)
    markers = "".join(f'<marker id="m-{k}" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="{KIND_COLOR[k]}"/></marker>' for k in kinds)
    legend = "".join(f'<span><i class="ln" style="border-color:{KIND_COLOR[k]};border-top-style:{"dashed" if k == "ping" else "dotted" if k == "owns" else "solid"}"></i>{k}: {KIND_TEXT[k]} ({sum(1 for e in edges if e.get("kind", "import") == k)})</span>' for k in kinds)
    legend += "".join(f'<span><i class="sw" style="background:{c}"></i>{k}</span>' for k, c in NODE_COLOR.items() if any(n.get("kind") == k for n in nodes))
    in_cyc = sum(1 for n in nodes if n["id"] in comp and len(comp[n["id"]]) > 1)
    pages_html = ('<p class="pg">' + " · ".join(f'<a href="{esc(p["href"])}">{esc(p["name"])}</a>' for p in graph["pages"]) + "</p>") if graph.get("pages") else ""
    lists_html = "".join(f'<section class="ls"><h2>{esc(b["title"])} ({len(b["rows"])})</h2>'
                         + ("<ul>" + "".join(f"<li>{tx(r)}</li>" for r in b["rows"]) + "</ul>" if b["rows"] else "<p>None.</p>") + "</section>"
                         for b in graph.get("lists", []))
    title = title or graph.get("title", "Dependency graph")
    out.write_text(f"""<!doctype html><html><head><meta charset="utf-8"><title>{esc(title)}</title><style>
body{{margin:0;background:#0e0f11;color:#d8dade;font:13px/1.4 -apple-system,system-ui,sans-serif}}
header{{padding:18px 22px 6px}}h1{{font-size:20px;margin:0 0 4px}}.meta{{font:11px ui-monospace,monospace;color:#8a8f98}}
p{{max-width:900px;color:#b8bcc4;margin:8px 0}}
.lg{{display:flex;flex-wrap:wrap;gap:14px;font:11px ui-monospace,monospace;color:#8a8f98;margin:8px 0}}.lg span{{display:inline-flex;align-items:center;gap:6px}}
.sw{{width:10px;height:10px;display:inline-block}}.ln{{width:22px;height:0;border-top:2px solid;display:inline-block}}
#fit{{margin:0 22px;font:11px ui-monospace,monospace;background:#22252b;color:#d8dade;border:1px solid #333;padding:4px 10px;cursor:pointer}}
.wrap{{position:relative;margin:10px 0 0}}svg{{position:absolute;left:0;top:0;overflow:visible}}
.e{{fill:none;stroke-width:1.4;opacity:.8}}.e.cyc{{stroke-width:2.8;opacity:1;filter:drop-shadow(0 0 3px #ff4d6d)}}.e.cut{{stroke:#ff4d6d;stroke-width:3;stroke-dasharray:8 5;opacity:1}}
.n{{position:absolute;box-sizing:border-box;border-left:3px solid;padding:6px 9px;overflow:hidden}}
.n i{{display:block;font:9px ui-monospace,monospace;font-style:normal;text-transform:uppercase;letter-spacing:.06em;color:#8a8f98;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}}
.n b{{display:block;font-size:12.5px;color:#fff;overflow-wrap:anywhere}}.n span{{display:block;font-size:11px;color:#8a8f98;line-height:1.3}}
.n code{{font:10.5px ui-monospace,monospace;color:#c9cdd4}}.n.cyc{{outline:1.5px solid #ff4d6d;outline-offset:2px}}
.pg a{{color:#8ab4ff}}.pg{{font:12px ui-monospace,monospace}}.ls{{margin:18px 22px;max-width:1100px}}.ls h2{{font-size:14px;margin:0 0 6px}}.ls ul{{margin:0;padding-left:18px;color:#b8bcc4}}.ls li{{margin:3px 0;overflow-wrap:anywhere}}
.wrap.focus .n{{opacity:.25}}.wrap.focus .n.on{{opacity:1}}.wrap.focus .e{{opacity:.06}}.wrap.focus .e.on{{opacity:1;stroke-width:2.4}}
</style></head><body><header><h1>{esc(title)}</h1>
<div class="meta">{len(nodes)} nodes · {len(edges)} edges · {in_cyc} in cycles</div>
<p>A node sits above the ones it depends on or acts on, so a chain stacks in one column. An edge that has to run upward closes a cycle and glows red; nodes in a cycle have a red outline; a red dashed edge is a suggested cut. Hover a node to see only its edges, hover an edge for what it carries.</p>
{pages_html}<div class="lg">{legend}</div></header>
<button id="fit">Actual size</button><div class="wrap" style="width:{gw:.0f}px;height:{gh:.0f}px"><svg width="{gw:.0f}" height="{gh:.0f}"><defs>{markers}</defs>{"".join(svg)}</svg>{"".join(boxes)}</div>
{lists_html}<script>
const wrap=document.querySelector('.wrap'),E=[...document.querySelectorAll('.e')],fitB=document.getElementById('fit');let fit=true;
function apply(){{const k=fit?Math.min(1,(innerWidth-20)/{gw:.0f}):1;wrap.style.zoom=k;fitB.textContent=fit?'Actual size':'Fit to window'}}
fitB.onclick=()=>{{fit=!fit;apply()}};addEventListener('resize',apply);apply();
document.querySelectorAll('.n').forEach(n=>{{n.onmouseenter=()=>{{wrap.classList.add('focus');n.classList.add('on');E.forEach(e=>{{if(e.dataset.a===n.id||e.dataset.b===n.id){{e.classList.add('on');document.getElementById(e.dataset.a).classList.add('on');document.getElementById(e.dataset.b).classList.add('on')}}}})}};
n.onmouseleave=()=>{{wrap.classList.remove('focus');document.querySelectorAll('.on').forEach(x=>x.classList.remove('on'))}}}});
</script></body></html>""")
    print(f"drew {len(nodes)} nodes, {len(edges)} edges, {in_cyc} in cycles: {out}")


def draw(args):
    draw_graph(json.loads(Path(args.graph).read_text()), Path(args.out), args.title)
    return 0


# ---------- structs ----------

RUST_BLIND = [
    "Callbacks and `Box<dyn Fn>` slots that call back up: not seen, look for them by hand.",
    "Trait objects (`Arc<dyn Trait>`): the field names a trait, so no edge to the implementors.",
    "Channels that carry a reply up (oneshot, request/reply pairs): no edge at all.",
    "Free fns have only outgoing edges: nothing draws who calls them, so they never close a cycle. One node stands for the fns of a file.",
    "Calls through a local that is not a plain alias or guard of a field or parameter (`let g = self.f.lock()`, `if let Some(b) = &self.b`), through closures and iterator chains, and `Type::function(..)` paths.",
    "Type aliases with generics (`type R<T> = ..`), and aliases whose name two modules share.",
    "Structs in another crate than the scanned tree, and structs the code never shares (not long-lived).",
    "Writers of a field are found only in the struct's own impl: a writer elsewhere shows as unknown.",
]
TS_BLIND = [
    "Callbacks and props handed between modules that call back up.",
    "Only `*-state.ts` and `create*Store` modules are nodes: views (`.tsx` components) that read a store through a hook are not drawn.",
    "Calls through re-exports, dynamic `import()` of a computed path, and methods on a value read out of `getState()`.",
    "Duplicated state is not computed for the frontend.",
]
LONG_FIELD = re.compile(r"\b(?:Arc|Weak|Mutex|RwLock|AsyncMutex|Sender|UnboundedSender|Receiver|UnboundedReceiver|JoinSet|JoinHandle|"
                        r"AbortOnDropHandle|Notify|Hub|Semaphore|OnceCell|OnceLock|Atomic\w+|DashMap)\b")
ACTOR_FIELD = re.compile(r"\b(?:JoinSet|JoinHandle|AbortOnDropHandle)\b")
LOCK_FIELD = re.compile(r"\b(?:Mutex|RwLock|AsyncMutex)\b")
PUSH_METHODS = {"send", "publish", "notify", "send_replace", "send_modify", "send_if_modified", "try_send", "notify_one", "notify_waiters"}
WRITE_OPS = ("insert|remove|push|push_back|push_front|pop|pop_front|pop_back|clear|retain|extend|entry|take|replace|set|send_replace|"
             "send_modify|store|swap|drain|truncate|get_mut|iter_mut|or_insert|append|resize|fetch_add|fetch_sub|fetch_or|write")
PLAIN_TYPES = {"Option", "Vec", "Mutex", "RwLock", "AsyncMutex", "HashMap", "BTreeMap", "HashSet", "BTreeSet", "VecDeque", "Sender", "Receiver",
               "Notify", "Result", "Box", "Cell", "RefCell", "String", "PathBuf", "Instant", "Duration", "SystemTime", "Self", "Value", "JoinSet",
               "JoinHandle", "Semaphore", "OnceCell", "OnceLock", "Some", "None", "Path", "Bytes", "Range", "Ordering", "UnboundedSender",
               "UnboundedReceiver", "AbortOnDropHandle", "BinaryHeap", "IndexMap", "DashMap", "Cow", "Pin", "Rc", "PhantomData"}
BRACES = re.compile(r"[{}]")
LEXEME = re.compile(r"""//|/\*|b?r#*"|"|'""")
TYPE_TOKEN = re.compile(r"[A-Za-z_]\w*(?:::[A-Za-z_]\w*)*|[<>(),\[\];&]")


def blank_lexemes(text: str):
    """Comments, strings and chars as spaces (newlines kept), so braces and names left are code."""
    out, last, pos = [], 0, 0
    while True:
        m = LEXEME.search(text, pos)
        if not m:
            break
        end = skip_lexeme(text, m.start())
        if end is None:
            pos = m.end()
            continue
        out += [text[last:m.start()], re.sub(r"[^\n]", " ", text[m.start():end])]
        last = pos = end
    out.append(text[last:])
    return "".join(out)


def rust_code(text: str):
    return blank_lexemes(without_cfg_test(text))


def block_end(text: str, i: int):
    """The index past the `}` that closes the `{` at or after i."""
    depth = 0
    for m in BRACES.finditer(text, i):
        depth += 1 if m.group() == "{" else -1
        if depth == 0:
            return m.end()
    return len(text)


def close_at(text: str, i: int, open_: str, close: str):
    """The index past the bracket that closes the one at i."""
    depth = 0
    for j in range(i, len(text)):
        depth += text[j] == open_
        depth -= text[j] == close
        if depth == 0:
            return j + 1
    return len(text)


def split_top(text: str, base: int = 0):
    """(offset, piece) of each top-level comma-separated piece."""
    out, depth, start = [], 0, 0
    flat = text.replace("->", "--")
    for i, ch in enumerate(flat):
        depth += ch in "([{<"
        depth -= ch in ")]}>"
        if ch == "," and depth == 0:
            out.append((base + start, text[start:i]))
            start = i + 1
    if text[start:].strip():
        out.append((base + start, text[start:]))
    return out


def type_refs(ty: str):
    """(path, wrappers) for each type path in a type, wrappers being the generic types around it."""
    stack, out, prev = [], [], ""
    for m in TYPE_TOKEN.finditer(ty.replace("->", "--")):
        t = m.group()
        if t == "<":
            stack.append(prev)
        elif t in "([":
            stack.append("")
        elif t in ">)]":
            if stack:
                stack.pop()
        elif t not in ",;&":
            out.append((t, tuple(stack)))
            prev = t.split("::")[-1]
    return out


def rust_fields(body: str, offset: int):
    fields = []
    for at, piece in split_top(body, offset):
        clean = re.sub(r"#\[[^\]]*\]", " ", piece).strip()
        clean = re.sub(r"^pub(?:\([^)]*\))?\s+", "", clean)
        m = re.match(r"(\w+)\s*:\s*(.+)", clean, re.S)
        if m:
            fields.append((m.group(1), re.sub(r"\s+", " ", m.group(2)).strip(), at + len(piece) - len(piece.lstrip())))
    return fields


def parse_structs(text: str):
    """(name, offset, fields, borrows) for each struct; a tuple struct's fields are _0, _1; borrows when it has a lifetime."""
    out = []
    for m in re.finditer(r"\bstruct\s+(\w+)", text):
        i = m.end()
        while text[i:i + 1].isspace():
            i += 1
        generics = ""
        if text[i:i + 1] == "<":
            j = close_at(text, i, "<", ">")
            generics, i = text[i:j], j
        n = re.compile(r"[{(;]").search(text, i)
        if not n:
            continue
        if n.group() == "{":
            end = block_end(text, n.start())
            fields = rust_fields(text[n.end():end - 1], n.end())
        elif n.group() == "(":
            end = close_at(text, n.start(), "(", ")")
            fields = [(f"_{k}", re.sub(r"\s+", " ", re.sub(r"^pub(?:\([^)]*\))?\s+", "", re.sub(r"#\[[^\]]*\]", " ", p).strip())), at)
                      for k, (at, p) in enumerate(split_top(text[n.end():end - 1], n.end())) if p.strip()]
        else:
            fields = []
        out.append((m.group(1), m.start(), fields, "'" in generics))
    return out


def prev_char(text: str, i: int):
    return text[:i].rstrip()[-1:]


def parse_blocks(text: str, keyword: str):
    """(type name, body start, body end) for each `impl` or `trait` block at item position."""
    out = []
    for m in re.finditer(rf"\b{keyword}\b", text):
        if prev_char(text, m.start()) not in ("", "}", ";", "{", "]") and not text[:m.start()].rstrip().endswith("unsafe"):
            continue
        i = m.end()
        n = re.compile(r"[{;]").search(text, i)
        if not n or n.group() == ";":
            continue
        header = text[i:n.start()]
        header = re.sub(r"^\s*<[^>]*(?:<[^>]*>[^>]*)*>", "", header) if header.lstrip().startswith("<") else header
        if keyword == "impl":
            if " for " in header:
                header = header.split(" for ", 1)[1]
            header = re.split(r"\bwhere\b", header)[0]
            t = re.match(r"\s*(?:dyn\s+)?&?\s*(?:mut\s+)?([\w:]+)", header)
        else:
            t = re.match(r"\s*(\w+)", header)
        if t:
            out.append((t.group(1).split("::")[-1], n.end(), block_end(text, n.start()) - 1))
    return out


def parse_fns(text: str, start: int, end: int):
    """(name, params, return type, body start, body end, offset) for each fn in text[start:end], skipping nested ones."""
    out, skip = [], start
    for m in re.finditer(r"\bfn\s+(\w+)", text[start:end]):
        at = start + m.start()
        if at < skip:
            continue
        i = start + m.end()
        if text[i:i + 1] == "<":
            i = close_at(text, i, "<", ">")
        p = text.find("(", i)
        if p < 0:
            continue
        pe = close_at(text, p, "(", ")")
        n = re.compile(r"[{;]").search(text, pe)
        if not n:
            continue
        sig = text[pe:n.start()]
        ret = re.split(r"\bwhere\b", sig.split("->", 1)[1])[0].strip() if "->" in sig else ""
        if n.group() == "{":
            be = block_end(text, n.start())
            out.append((m.group(1), text[p + 1:pe - 1], ret, n.end(), be - 1, at))
            skip = be
        else:
            out.append((m.group(1), text[p + 1:pe - 1], ret, n.end(), n.end(), at))
            skip = n.end()
    return out


def order_return(ret: str):
    r = re.sub(r"\s+", "", ret)
    return r in ("", "()") or bool(re.fullmatch(r"(?:\w+::)*Result<\(\)(?:,[^<>]*(?:<[^<>]*>)?)?>", r))


class Source:
    """One scanned file: its code, its line index and its place under the tree."""

    def __init__(self, rel: str, text: str, tree: str):
        self.rel, self.code = rel, rust_code(text)
        self.nl = [m.start() for m in re.finditer("\n", self.code)]
        parts = Path(rel).relative_to(tree).with_suffix("").parts if tree and rel.startswith(tree + "/") else Path(rel).with_suffix("").parts
        self.group = parts[0] if parts else Path(rel).stem

    def line(self, at: int):
        import bisect
        return bisect.bisect_left(self.nl, at) + 1


def closeness(path: str, here: str, cand: str, segs):
    cparts = Path(cand).with_suffix("").parts
    score = sum(1 for s in segs if s in cparts)
    common = 0
    for a, b in zip(Path(here).parent.parts, Path(cand).parent.parts):
        if a != b:
            break
        common += 1
    return (score, cand == here, common)


def pick(pool, name: str, path: str, here: str):
    cands = pool.get(name, [])
    if len(cands) <= 1:
        return cands[0] if cands else None
    segs = [s for s in path.split("::")[:-1] if s not in ("crate", "self", "super")]
    return max(cands, key=lambda c: closeness(path, here, c.split("::")[0], segs))


CHAIN_ADAPT = r"(?:\s*\.\s*(?:lock|read|write|borrow|borrow_mut|clone|as_ref|as_deref|as_mut|unwrap|get)\s*\(\s*\))*(?:\s*\.\s*await)?\s*\??"
ALIAS_LET = (r"let\s+(?:mut\s+)?(\w+)\s*(?::[^=;]+)?=\s*(?:Arc::clone\(\s*&?(\w+)\s*\.\s*(\w+)\s*\)|(?:\w+::)*lock\(\s*&(?:mut\s+)?(\w+)\s*\.\s*(\w+)\s*\)"
             r"|&?(?:mut\s+)?(\w+)\s*\.\s*(\w+))" + CHAIN_ADAPT + r"\s*(?:;|else\b)")
ALIAS_SOME = r"let\s+Some\(\s*(?:ref\s+)?(?:mut\s+)?(\w+)\s*\)\s*=\s*&?(?:mut\s+)?(\w+)\s*\.\s*(\w+)(?:\s*\.\s*(?:as_ref|as_deref|as_mut|clone)\s*\(\s*\))?\s*(?=\{|;|else\b|\))"
CALL2 = r"\b(\w+)\s*\.\s*(\w+)\s*(?:::<[^>]*>)?\s*\("
CALL3 = r"\b(\w+)\s*\.\s*(\w+)\s*\.\s*(\w+)\s*(?:::<[^>]*>)?\s*\("
CALL_GUARD = (r"\b(\w+)\s*\.\s*(\w+)\s*\.\s*(?:lock|read|write|borrow|borrow_mut)\s*\(\s*\)(?:\s*\.\s*await|\s*\.\s*unwrap\s*\(\s*\)|\s*\?)*"
              r"\s*\.\s*(\w+)\s*(?:::<[^>]*>)?\s*\(")
CALL_LOCK = r"(?:\w+::)*lock\(\s*&(?:mut\s+)?(\w+)\s*\.\s*(\w+)\s*\)(?:\s*\.\s*await)?\s*\.\s*(\w+)\s*(?:::<[^>]*>)?\s*\("


def field_key(name: str):
    """Tuple fields are written `self.0` and stored as `_0`."""
    return f"_{name}" if name.isdigit() else name


def field_access(fname: str):
    n = fname[1:] if re.fullmatch(r"_\d+", fname) else fname
    return rf"(?:\bself\s*\.\s*{n}\b|(?:\w+::)*lock\(\s*&(?:mut\s+)?self\s*\.\s*{n}\s*\))"


def writes_field(body: str, access: str):
    """Whether the method assigns the field, calls a mutating op on it, or does so through a guard local."""
    if re.search(rf"{access}\s*[-+|&]?=(?!=)|{access}[^;{{}}]*?\.\s*(?:{WRITE_OPS})\s*\(|\*\s*{access}[^;{{}}=]*?(?<![=!<>])=(?!=)", body):
        return True
    for m in re.finditer(rf"let\s+(?:mut\s+)?(\w+)\s*(?::[^=;]+)?=[^;]*?{access}[^;]*;", body):
        g = m.group(1)
        if re.search(rf"\b{g}\s*\.\s*(?:{WRITE_OPS})\s*\(|\*\s*{g}\s*[-+|&]?=(?!=)|\b{g}\s*\.\s*\w+\s*[-+|&]?=(?!=)", body[m.end():]):
            return True
    return False


def build_rust(sources: dict, tree: str = ""):
    """The struct graph of the Rust sources {repo-relative path: text}, and the facts the analysis reads."""
    files = {rel: Source(rel, text, tree) for rel, text in sources.items()}
    found_aliases = {}
    for s in files.values():
        for m in re.finditer(r"\btype\s+([A-Z]\w*)\s*=\s*([^;]+);", s.code):
            found_aliases.setdefault(m.group(1), []).append(re.sub(r"\s+", " ", m.group(2)).strip())
    parsed = {rel: parse_structs(s.code) for rel, s in files.items()}
    taken = {name for items in parsed.values() for name, *_ in items}
    for s in files.values():
        taken |= set(re.findall(r"\b(?:enum|union|trait)\s+(\w+)", s.code))
    aliases = {k: v[0] for k, v in found_aliases.items() if len(v) == 1 and k not in taken and "<" not in v[0][:1]}

    def unalias(ty):
        for _ in range(3):
            ty = re.sub(r"\b[A-Z]\w*\b", lambda m: aliases.get(m.group(0), m.group(0)), ty)
        return ty

    structs = {}  # id -> dict
    for rel, s in files.items():
        for name, at, fields, borrows in parsed[rel]:
            structs[f"{rel}::{name}"] = dict(name=name, rel=rel, line=s.line(at), fields=[(n, unalias(t), s.line(a)) for n, t, a in fields], group=s.group, borrows=borrows)
    every = {}  # every type name: structs, and enums and aliases that no node can be
    for sid, st in structs.items():
        every.setdefault(st["name"], []).append(sid)
    for rel, s in files.items():
        for m in re.finditer(r"\b(?:enum|type|union|trait)\s+(\w+)", s.code):
            every.setdefault(m.group(1), []).append(f"{rel}::{m.group(1)}")

    shared = set()
    for rel, s in files.items():
        for m in re.finditer(r"\b(?:Arc|Weak)\s*<\s*((?:\w+::)*)([A-Z]\w*)|\bArc::new\(\s*((?:\w+::)*)([A-Z]\w*)|\bArc::<\s*((?:\w+::)*)([A-Z]\w*)", s.code):
            g = m.groups()
            prefix, name = next((g[i], g[i + 1]) for i in (0, 2, 4) if g[i + 1])
            sid = pick(every, name, prefix + name, rel)
            if sid in structs:
                shared.add(sid)
    for sid, st in structs.items():
        for _, ty, _ in st["fields"]:
            for path, wr in type_refs(ty):
                if "Arc" in wr or "Weak" in wr:
                    other = pick(every, path.split("::")[-1], path, st["rel"])
                    if other in structs:
                        shared.add(other)
    nodes = {sid for sid, st in structs.items()
             if not st["borrows"] and (sid in shared or any(LONG_FIELD.search(t) for _, t, _ in st["fields"]))}

    def node_for(path, here):
        found = pick(every, path.split("::")[-1], path, here)
        return found if found in nodes else None

    impls = []  # (struct id, rel, body start, body end)
    spans = {rel: [] for rel in files}
    for rel, s in files.items():
        for kw in ("impl", "trait"):
            for name, a, b in parse_blocks(s.code, kw):
                spans[rel].append((a, b))
                if kw == "impl":
                    sid = pick(every, name, name, rel)
                    if sid in structs:
                        impls.append((sid, rel, a, b))
    methods = {}  # struct id -> {name: return type}
    scopes = []  # (source id, struct id or None, rel, params, body start, body end)
    spawners = set()
    for sid, rel, a, b in impls:
        s = files[rel]
        for name, params, ret, ba, bb, at in parse_fns(s.code, a, b):
            methods.setdefault(sid, {}).setdefault(name, ret)
            scopes.append((sid, sid, rel, params, ba, bb, name))
            if re.search(r"\bspawn\w*\s*\(", s.code[ba:bb]):
                spawners.add(sid)
    free = []
    for rel, s in files.items():
        for name, params, ret, ba, bb, at in parse_fns(s.code, 0, len(s.code)):
            if not any(a <= at < b for a, b in spans[rel]):
                free.append((f"{rel}::fns", None, rel, params, ba, bb, name))

    out_nodes = {}
    for sid in sorted(nodes):
        st = structs[sid]
        types = " ".join(t for _, t, _ in st["fields"])
        kind = ("actor" if ACTOR_FIELD.search(types) or sid in spawners else "lock" if LOCK_FIELD.search(types)
                else "store" if st["fields"] else "stateless")
        out_nodes[sid] = dict(id=sid, name=st["name"], group=st["group"], kind=kind, note=f"{st['rel']}:{st['line']}")
    edges, serving = {}, {}

    def add(a, b, kind, label, weak=False):
        if a == b:
            return
        e = edges.setdefault((a, b, kind), dict(**{"from": a, "to": b}, kind=kind, label=label, weak=weak, count=0))
        e["weak"] = e["weak"] and weak
        e["count"] += 1

    for sid in sorted(nodes):
        st = structs[sid]
        for fname, ty, line in st["fields"]:
            for path, wr in type_refs(ty):
                target = node_for(path, st["rel"])
                if target:
                    add(sid, target, "owns", f"{fname} ({st['rel']}:{line})", "Weak" in wr)

    def classify(target, method):
        if method in PUSH_METHODS or method.startswith(("publish", "notify")):
            return "push" if method in methods.get(target, {}) else None
        if method not in methods.get(target, {}):
            return None
        return "order" if order_return(methods[target][method]) else "ask"

    field_nodes = {}
    for sid in nodes:
        st = structs[sid]
        field_nodes[sid] = {f: [t for t in (node_for(p, st["rel"]) for p, _ in type_refs(ty)) if t]
                            for f, ty, _ in st["fields"]}

    for src, sid, rel, params, ba, bb, fname in scopes + free:
        s = files[rel]
        body = s.code[ba:bb]
        bind = {}  # local name -> node ids
        for _, p in split_top(params):
            m = re.match(r"\s*(?:mut\s+)?(\w+)\s*:\s*(.+)", p, re.S)
            if m:
                t = [x for x in (node_for(path, rel) for path, _ in type_refs(unalias(m.group(2)))) if x]
                if t:
                    bind[m.group(1)] = t
        if sid in nodes:
            bind["self"] = [sid]
        aliases_here = []
        for m in re.finditer(ALIAS_LET, body):
            aliases_here.append((m.start(), m.group(1), next((m.group(k), m.group(k + 1)) for k in (2, 4, 6) if m.group(k))))
        for m in re.finditer(ALIAS_SOME, body):
            aliases_here.append((m.start(), m.group(1), (m.group(2), m.group(3))))
        for _, local, (owner, field) in sorted(aliases_here):
            for t in bind.get(owner, [])[:1]:
                got = field_nodes.get(t, {}).get(field_key(field))
                if got:
                    bind[local] = got
        if not bind:
            continue
        found = []
        for m in re.finditer(CALL2, body):
            for t in bind.get(m.group(1), []):
                k = classify(t, m.group(2))
                if k and m.group(1) != "self":
                    found.append((t, k, f"{m.group(1)}.{m.group(2)}", m.start()))
        for pattern, shape in ((CALL3, (1, 2, 3)), (CALL_GUARD, (1, 2, 3)), (CALL_LOCK, (1, 2, 3))):
            for m in re.finditer(pattern, body):
                owner, field, method = (m.group(i) for i in shape)
                for owner_node in bind.get(owner, []):
                    for t in field_nodes.get(owner_node, {}).get(field_key(field), []):
                        k = classify(t, method)
                        if k:
                            found.append((t, k, f"{field}.{method}", m.start()))
        for t, k, what, at in found:
            if src not in out_nodes:
                mod = Path(rel).with_suffix("")
                out_nodes[src] = dict(id=src, name=f"fns in {(mod.parent if mod.name in ('mod', 'lib', 'main') else mod).name}", group=s.group, kind="stateless", note=rel)
            if src.endswith("::fns"):
                serving.setdefault(src, set()).add(fname)
            if src != t:
                edges.setdefault((src, t, k), dict(**{"from": src, "to": t}, kind=k, label=f"{what} ({rel}:{s.line(ba + at)})", weak=False, count=0))["count"] += 1

    for sid, fns in serving.items():
        out_nodes[sid]["note"] += f": {len(fns)} fn{'s' if len(fns) > 1 else ''} that take a node ({', '.join(sorted(fns)[:4])}{', ...' if len(fns) > 4 else ''})"
    names = {}
    for n in out_nodes.values():
        names[n["name"]] = names.get(n["name"], 0) + 1
    for sid, n in out_nodes.items():
        if names[n["name"]] > 1:
            mod = Path(sid.split("::")[0]).with_suffix("")
            n["name"] = f"{(mod.parent if mod.name in ('mod', 'lib', 'main') else mod).name}::{n['name']}"

    # writers of each field
    writers = {}
    for sid, st in structs.items():
        if sid not in nodes:
            continue
        for fname, ty, line in st["fields"]:
            access = field_access(fname)
            names = []
            for src, owner, rel, params, ba, bb, mname in scopes:
                if owner == sid and writes_field(files[rel].code[ba:bb], access):
                    names.append(mname)
            writers[(sid, fname)] = sorted(set(names))
    return dict(nodes=out_nodes, edges=list(edges.values()), structs=structs, node_ids=nodes, writers=writers, every=every)


HANDLE_TYPES = {"Dir", "Group", "Mesh", "Endpoint", "AppHandle", "CancellationToken", "Uuid", "WebviewWindow", "Window", "Runtime"}
HANDLE_FIELD = re.compile(r"\b(?:Arc|Weak|Sender|UnboundedSender|Receiver|Notify|Hub|JoinSet|JoinHandle|AbortOnDropHandle|CancellationToken|Semaphore)\b")


def duplicated_state(info):
    """Rows of (type, field, [(node name, file:line, writers)]) for state of one type held by two nodes.

    Types compare by the module that defines them, so two private `Turn`s do not match; handles
    (types made of Arc, channels, tokens, or named in HANDLE_TYPES) are shared, not copied."""
    structs, nodes, every = info["structs"], info["node_ids"], info["every"]

    def handle_like(sid):
        st = structs.get(sid)
        return bool(st and st["fields"] and all(HANDLE_FIELD.search(t) for _, t, _ in st["fields"]))

    by_type, by_key = {}, {}
    for sid in sorted(nodes):
        st = structs[sid]
        for fname, ty, line in st["fields"]:
            if HANDLE_FIELD.search(ty):
                continue
            payload, norm = set(), ty
            for m in sorted({m.group(0) for m in re.finditer(r"(?:\w+::)*[A-Z]\w*", ty)}, key=len, reverse=True):
                last = m.split("::")[-1]
                if last in PLAIN_TYPES or last.startswith("Atomic"):
                    continue
                if last in HANDLE_TYPES:
                    payload = None
                    break
                found = pick(every, last, m, st["rel"])
                if found:
                    norm = norm.replace(m, found)
                    if found not in nodes and not handle_like(found) and not re.search(r"(?:Id|Name|Kid|Key)$", last):
                        payload.add(found)
            if payload is None:
                continue
            keyed = bool(re.search(r"Map<\w*Id,", re.sub(r"\s+", "", ty)))
            if not payload and not keyed:
                continue
            row = (st["name"], f"{st['rel']}:{line}", info["writers"].get((sid, fname), []), fname, sid, ty)
            by_type.setdefault((re.sub(r"\s+", "", norm), fname), []).append(row)
            if keyed:
                by_key.setdefault(re.sub(r"\s+", "", norm), []).append(row)
    rows = []
    for (norm, fname), group in by_type.items():
        if len({r[4] for r in group}) > 1:
            rows.append((re.sub(r"\s+", "", group[0][5]), fname, [r[:3] for r in group]))
    seen = {r[0] for r in rows}
    for norm, group in by_key.items():
        if len({r[4] for r in group}) > 1 and len({r[3] for r in group}) > 1 and re.sub(r"\s+", "", group[0][5]) not in seen:
            rows.append((re.sub(r"\s+", "", group[0][5]), "/".join(sorted({r[3] for r in group})), [r[:3] for r in group]))
    return sorted(rows, key=lambda r: -len(r[2]))


def merge_infos(infos):
    out = dict(nodes={}, edges=[], structs={}, node_ids=set(), writers={}, every={})
    for info in infos:
        out["nodes"].update(info["nodes"])
        out["edges"] += info["edges"]
        out["structs"].update(info["structs"])
        out["node_ids"] |= info["node_ids"]
        out["writers"].update(info["writers"])
        for name, ids in info["every"].items():
            out["every"].setdefault(name, []).extend(i for i in ids if i not in out["every"].get(name, []))
    return out


# TypeScript stores

TS_IMPORT = re.compile(r'import\s+(type\s+)?([\w$]+\s*,?\s*)?(?:\{([^}]*)\}|\*\s+as\s+([\w$]+))?\s*from\s*["\']([^"\']+)["\']')
NATIVE_PUSH = {"listen", "subscribeEach", "subscribeChanges", "topic"}
NATIVE_FILES = ("ui/tauri.ts", "ui/mesh-events.ts")


def ts_code(text: str):
    text = re.sub(r"/\*.*?\*/", lambda m: re.sub(r"[^\n]", " ", m.group()), text, flags=re.S)
    return re.sub(r"(?<![:\w\"'`])//[^\n]*", "", text)


def is_ts_store(rel: str, text: str):
    return rel.endswith("-state.ts") or bool(re.search(r"\bcreate\w*Store\s*[(<]|\bcreate\s*<", text))


def build_ts(sources: dict):
    """The store graph of {repo-relative path: text}: modules ending -state.ts or holding a create*Store."""
    code = {rel: ts_code(t) for rel, t in sources.items()}
    nodes = {}
    for rel, text in code.items():
        if is_ts_store(rel, text):
            kind = "store" if re.search(r"\bcreate\w*Store\s*[(<]|\bcreate\s*<|^(?:export\s+)?let\s", text, re.M) else "stateless"
            parts = Path(rel).parts
            group = "/".join(parts[parts.index("src") + 1:-1]) if "src" in parts else "/".join(parts[:-1])
            nodes[rel] = dict(id=rel, name=Path(rel).name, group=group, kind=kind, note=rel)
    edges = {}

    def add(a, b, kind, what, rel, at):
        e = edges.setdefault((a, b, kind), dict(**{"from": a, "to": b}, kind=kind, label=f"{what} ({rel}:{code[rel].count(chr(10), 0, at) + 1})", weak=False, count=0))
        e["count"] += 1

    for rel, text in code.items():
        if rel not in nodes:
            continue
        for m in TS_IMPORT.finditer(text):
            if m.group(1):
                continue
            spec = m.group(5)
            if not spec.startswith("."):
                continue
            target = os.path.normpath(os.path.join(os.path.dirname(rel), spec))
            native = target.endswith(NATIVE_FILES)
            if target not in nodes and not native:
                continue
            local = {}  # local name -> imported name
            for item in (m.group(3) or "").split(","):
                item = item.strip()
                if item and not item.startswith("type "):
                    name, _, alias = item.partition(" as ")
                    local[(alias or name).strip()] = name.strip()
            if m.group(2) and m.group(2).strip(" ,"):
                local[m.group(2).strip(" ,")] = "default"
            if m.group(4):
                local[m.group(4)] = "*"
            for name, srcal in local.items():
                n = re.escape(name)
                if native:
                    if "ui/tauri.ts" in target and srcal == "invoke":
                        for c in re.finditer(rf"\b{n}\s*[<(]", text):
                            bare = re.search(r"(?:^|[;{}])\s*(?:await\s+|void\s+)?$", text[max(0, c.start() - 40):c.start()])
                            add(rel, "native", "order" if bare else "ask", "invoke", rel, c.start())
                    elif srcal in NATIVE_PUSH:
                        c = re.search(rf"\b{n}\s*[<(]", text)
                        if c:
                            add("native", rel, "push", srcal, rel, c.start())
                    continue
                for c in re.finditer(rf"\b{n}\.getState\s*\(", text):
                    add(rel, target, "ask", f"{name}.getState", rel, c.start())
                for c in re.finditer(rf"\b{n}\.setState\s*\(", text):
                    add(rel, target, "order", f"{name}.setState", rel, c.start())
                for c in re.finditer(rf"\b{n}\.subscribe\s*\(|\buse\w*\(\s*{n}\b", text):
                    add(target, rel, "push", f"{name}.subscribe", rel, c.start())
                if srcal.startswith("use") and re.match(r"use[A-Z]", srcal):
                    for c in re.finditer(rf"\b{n}\s*\(", text):
                        add(target, rel, "push", f"{name}()", rel, c.start())
                else:
                    for c in re.finditer(rf"(?<![.\w]){n}\s*(?:<[^<>()]*>)?\(", text):
                        pre = text[max(0, c.start() - 40):c.start()]
                        bare = re.search(r"(?:^|[;{}])\s*(?:await\s+|void\s+)?$", pre)
                        add(rel, target, "order" if bare else "ask", f"{name}()", rel, c.start())
                    if srcal == "*":
                        for c in re.finditer(rf"\b{n}\.(\w+)\s*\(", text):
                            add(rel, target, "ask", f"{name}.{c.group(1)}", rel, c.start())
    if any("native" in (a, b) for a, b, _ in edges):
        nodes["native"] = dict(id="native", name="native (invoke, listen)", group="native", kind="actor", note="the Tauri side")
    return dict(nodes=nodes, edges=list(edges.values()))


def analyse(nodes: dict, edges: list, info=None):
    """Cycle groups on owns|ask|order with cuts, the pushes that close a cycle upward, and duplicated state."""
    plain = {(e["from"], e["to"]) for e in edges if e["kind"] in ("owns", "ask", "order") and e["from"] in nodes and e["to"] in nodes}
    cycle_groups = []
    for g in groups(plain):
        inside = {e for e in plain if e[0] in g and e[1] in g}
        steps = [(a, b) for (a, b), _, _ in cuts(inside, 8)]
        cycle_groups.append(dict(members=sorted(g), cuts=steps))
    adj = {}
    for a, b in plain:
        adj.setdefault(a, set()).add(b)

    def reaches(a, b):
        seen, todo = {a}, [a]
        while todo:
            for w in adj.get(todo.pop(), ()):
                if w == b:
                    return True
                if w not in seen:
                    seen.add(w)
                    todo.append(w)
        return False

    upward = [e for e in edges if e["kind"] == "push" and e["from"] in nodes and e["to"] in nodes and reaches(e["to"], e["from"])]
    return dict(cycle_groups=cycle_groups, upward=upward, duplicated=duplicated_state(info) if info else [])


def struct_lists(nodes, edges, result, rust: bool, ts: bool):
    """The lists under a page: only what the scanned languages compute."""
    name = lambda i: nodes[i]["name"] if i in nodes else i
    lab = {(e["from"], e["to"], e["kind"]): e["label"] for e in edges}
    cyc = []
    for g in result["cycle_groups"]:
        cut = "; ".join(f"cut `{name(a)}` to `{name(b)}`: {lab.get((a, b, 'owns')) or lab.get((a, b, 'ask')) or lab.get((a, b, 'order'), '')}" for a, b in g["cuts"])
        cyc.append(f"{len(g['members'])} in a cycle: " + ", ".join(f"`{name(m)}`" for m in g["members"][:12]) + (" ..." if len(g["members"]) > 12 else "") + (f". Fewest cuts: {cut}" if cut else ""))
    up = [f"`{name(e['from'])}` pushes to `{name(e['to'])}`: {e['label']}" + (f" ({e['count']} sites)" if e["count"] > 1 else "")
          for e in result["upward"] if e["from"] != "native"]
    native = [name(e["to"]) for e in result["upward"] if e["from"] == "native"]
    if native:
        up.append(f"`native` pushes events to {len(native)} stores that also invoke it (the expected loop): " + ", ".join(f"`{n}`" for n in native))
    lists = [dict(title="Cycle groups on owns, ask and order, with the fewest cuts", rows=cyc),
             dict(title="Upward pushes (a push that closes a cycle: allowed, listed)", rows=up)]
    if rust:
        dup = [f"`{norm}` as `{fname}`: " + "; ".join(f"`{n}` {loc}" + (f" (writes: {', '.join(w[:3])})" if w else " (writer unknown)") for n, loc, w in rows)
               for norm, fname, rows in result["duplicated"]]
        lists.append(dict(title="Duplicated state (same type from the same module, same name or same id-keyed map, in two or more nodes)", rows=dup))
    lists.append(dict(title="Blind spots", rows=(RUST_BLIND if rust else []) + (TS_BLIND if ts else [])))
    return lists


PAGE_NODES = 90
SMALL_AREA = 8
NEIGHBORS = 14


def node_area(node, prefixes, depth):
    """The folder a node lives in, `depth` levels below its tree, or its file when it sits higher."""
    path = node["id"].split("::")[0]
    if node["id"] == "native":
        return "native"
    for prefix in prefixes:
        if prefix and path.startswith(prefix + "/"):
            path = path[len(prefix) + 1:]
            break
    parts = Path(path).parts
    dirs = parts[:-1]
    return "/".join(dirs[:depth]) if dirs else Path(path).stem


def draw_pages(graph, out: Path, tree_prefixes, depth):
    """One page when the graph fits a screen. Else an overview of the areas (with the lists) and one page per area
    that shows its nodes and the nodes they touch; an area too big for a page is split a folder deeper."""
    nodes = {n["id"]: n for n in graph["nodes"]}
    if len(nodes) <= PAGE_NODES:
        draw_graph(graph, out)
        return
    area = {i: node_area(n, tree_prefixes, depth) for i, n in nodes.items()}
    for _ in range(3):
        size = {}
        for a in area.values():
            size[a] = size.get(a, 0) + 1
        big = {a for a, c in size.items() if c > PAGE_NODES}
        if not big:
            break
        area = {i: (node_area(nodes[i], tree_prefixes, depth + 1 + _) if a in big else a) for i, a in area.items()}
    size = {}
    for a in area.values():
        size[a] = size.get(a, 0) + 1
    area = {i: (a if size[a] >= SMALL_AREA else "small areas") for i, a in area.items()}
    slug = lambda a: re.sub(r"[^\w]+", "-", a).strip("-")
    areas = sorted(set(area.values()))
    pages = {a: f"{out.stem}-{slug(a)}.html" for a in areas}
    for a in areas:
        keep = {i for i in nodes if area[i] == a}
        touching = {}
        for e in graph["edges"]:
            if e["from"] in nodes and e["to"] in nodes and (e["from"] in keep) != (e["to"] in keep):
                other = e["to"] if e["from"] in keep else e["from"]
                touching[other] = touching.get(other, 0) + 1
        near = sorted(touching, key=lambda i: -touching[i])[:NEIGHBORS]
        include = keep | set(near)
        sub = dict(graph, title=f"{graph['title']}: {a}", nodes=[nodes[i] for i in nodes if i in include],
                   edges=[e for e in graph["edges"] if (e["from"] in keep or e["to"] in keep) and e["from"] in include and e["to"] in include],
                   lists=[], pages=[dict(name="all areas", href=out.name)] + ([dict(name=f"{len(touching) - len(near)} more nodes outside touch this area and are not drawn", href=out.name)] if len(touching) > len(near) else []))
        draw_graph(sub, out.with_name(pages[a]))
    count, links = {}, {}
    for e in graph["edges"]:
        if e["from"] in area and e["to"] in area and area[e["from"]] != area[e["to"]]:
            key = (area[e["from"]], area[e["to"]], e["kind"])
            count[key] = count.get(key, 0) + 1
    over = dict(graph, nodes=[dict(id=a, name=a, group=a.split("/")[0], kind="module", note=f"{sum(1 for v in area.values() if v == a)} nodes") for a in areas],
                edges=[{"from": a, "to": b, "kind": k, "label": f"{c} edges between the nodes", "weak": False, "count": c} for (a, b, k), c in count.items()],
                cycle_kinds=["none"], pages=[dict(name=f"{a} ({sum(1 for v in area.values() if v == a)} nodes)", href=pages[a]) for a in areas],
                title=graph["title"] + ": areas")
    draw_graph(over, out)


def struct_files(repo: Path, tree: Path, lang: str):
    exts = [".rs"] if lang == "rust" else list(TS_EXT)
    for e in exts:
        for f in sorted(walk(tree, "*" + e)):
            if f.name.endswith(".d.ts") or (lang == "ts" and re.search(r"\.(test|spec)\.", f.name)):
                continue
            if lang == "rust" and ("tests" in f.relative_to(tree).parts or f.name in ("tests.rs", "test.rs")):
                continue
            yield f.relative_to(repo).as_posix(), f


def structs(args):
    root = Path(args.root).resolve()
    graph_nodes, graph_edges, infos, langs = {}, [], [], set()
    trees = selected(root, args.tree)
    title = "Struct graph of " + ", ".join(t.relative_to(root).as_posix() or "." for _, t in trees)
    for lang, tree in trees:
        src = {rel: f.read_text(errors="replace") for rel, f in struct_files(root, tree, lang)}
        if lang == "rust":
            res = build_rust(src, tree.relative_to(root).as_posix())
            infos.append(res)
        elif lang == "ts":
            res = build_ts(src)
        else:
            continue
        langs.add(lang)
        graph_nodes.update(res["nodes"])
        graph_edges += res["edges"]
    info = merge_infos(infos) if infos else None
    result = analyse(graph_nodes, graph_edges, info)
    lists = struct_lists(graph_nodes, graph_edges, result, "rust" in langs, "ts" in langs)
    graph = dict(title=title, nodes=list(graph_nodes.values()), edges=graph_edges, cycle_kinds=["owns", "ask", "order"], lists=lists,
                 pack=True)
    kinds = {}
    for e in graph_edges:
        kinds[e["kind"]] = kinds.get(e["kind"], 0) + 1
    print(f"{title}\n  {len(graph_nodes)} nodes, {len(graph_edges)} edges {kinds}")
    print(f"  {len(result['cycle_groups'])} struct cycle groups, {len(result['upward'])} upward pushes, {len(result['duplicated'])} duplicated-state rows")
    for block in lists:
        print(f"\n{block['title']} ({len(block['rows'])})")
        for row in block["rows"]:
            print("  " + row.replace("`", ""))
    if args.json:
        Path(args.json).write_text(json.dumps(graph, indent=1) + "\n")
    if args.draw:
        draw_pages(graph, Path(args.draw), tree_prefixes=[t.relative_to(root).as_posix() for _, t in trees], depth=2 if "ts" in langs else 1)
    return 0


# ---------- timers ----------

TIMER_CALLS = {
    "rust": re.compile(r"\b(?:thread::sleep|interval_at|interval|sleep_until|sleep)\s*\("),
    "ts": re.compile(r"\b(?:setInterval|setTimeout)\s*\("),
    "py": re.compile(r"\b(?:time\.sleep|asyncio\.sleep)\s*\("),
}
FN_DEF = {
    "rust": re.compile(r"^\s*(?:pub(?:\([^)]*\))?\s+)?(?:const\s+)?(?:async\s+)?(?:unsafe\s+)?fn\s+(\w+)"),
    "ts": re.compile(r"^\s*(?:export\s+)?(?:default\s+)?(?:async\s+)?function\s*\*?\s*(\w+)|^\s*(?:export\s+)?(?:const|let|var)\s+(\w+)\s*(?::[^=]+)?=\s*(?:async\s*)?(?:\(|\w+\s*=>|function)|^\s*(?:public\s+|private\s+|protected\s+|static\s+|async\s+|readonly\s+)*(\w+)\s*\([^;]*\)\s*(?::[^{]+)?\{\s*$"),
    "py": re.compile(r"^\s*(?:async\s+)?def\s+(\w+)"),
}
KINDS = {
    "poll": "rereads state the codebase owns on a timer: a defect to replace with a push",
    "retry": "tries a failed connection or call again",
    "debounce": "waits for a burst of events to settle before acting once",
    "deadline": "bounds how long something may take",
    "outside": "reads a source that cannot push (OS, CLI, forge, device tools)",
    "ui": "animation, focus, layout or another user interface timing",
    "pace": "spaces out work on purpose, such as a rate limit or a batch window",
    "compat": "asks an older peer that cannot push; remove once those versions are gone",
}
KEYWORDS = {"if", "for", "while", "switch", "catch", "return", "match", "loop", "else", "with", "new"}
NOT_CODE = re.compile(r"^\s*(?://|#|\*|/\*)")


def timer_files(root: Path, lang: str):
    pattern = {"rust": ["*.rs"], "ts": ["*" + e for e in TS_EXT], "py": ["*.py"]}[lang]
    for p in pattern:
        for f in walk(root, p):
            rel = f.relative_to(root).parts
            if "tests" in rel or "test" in rel or re.search(r"\.(spec|test)\.\w+$|_test\.py$|^test_", f.name):
                continue
            yield f


def timer_sites(repo: Path, trees):
    """Every timer call outside tests: (key, file, line, function, call, context)."""
    sites = []
    for lang, tree in trees:
        for f in sorted(timer_files(tree, lang)):
            text = f.read_text(errors="replace")
            if lang == "rust":
                text = without_cfg_test(text)
            lines = text.splitlines()
            fn, seen = "<top>", {}
            for i, line in enumerate(lines):
                m = FN_DEF[lang].match(line)
                name = next((g for g in m.groups() if g), None) if m else None
                if name and name not in KEYWORDS:
                    fn = name
                if NOT_CODE.match(line):
                    continue
                for c in TIMER_CALLS[lang].finditer(line):
                    if re.search(r"(?:\bfn|\bfunction|\bdef)\s+$", line[: c.start()]):
                        continue
                    call = c.group(0).rstrip("( ").split("::")[-1].split(".")[-1]
                    path = f.relative_to(repo).as_posix()
                    n = seen[(fn, call)] = seen.get((fn, call), 0) + 1
                    key = f"{path} | {fn} | {call}#{n}"
                    ctx = "\n".join(lines[max(0, i - 3): i + 5])
                    sites.append(dict(key=key, file=path, line=i + 1, function=fn, call=call, context=ctx))
    return sites


def read_allow(path: Path):
    allow = {}
    if not path.exists():
        return allow
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = [p.strip() for p in line.split("|")]
        if len(parts) < 5:
            continue
        key = " | ".join(parts[:3])
        allow[key] = dict(kind=parts[3], reason=" | ".join(parts[4:]))
    return allow


def timers(args):
    root = Path(args.root).resolve()
    sites = timer_sites(root, selected(root, args.tree))
    allow_path = root / args.allow
    allow = read_allow(allow_path)
    keys = {s["key"] for s in sites}
    by_kind, unknown, bad = {}, [], []
    for s in sites:
        a = allow.get(s["key"])
        if a is None or a["kind"] == "?":
            unknown.append(s)
        elif a["kind"] not in KINDS:
            bad.append((s, a["kind"]))
        else:
            by_kind.setdefault(a["kind"], []).append(s)
    stale = sorted(k for k in allow if k not in keys)

    if args.write:
        out = ["# Every timer and sleep outside tests, with what it is for. Kept by `depgraph timers`.",
               "# path | function | call#n | kind | reason",
               "# kinds: " + ", ".join(KINDS), ""]
        for s in sorted(sites, key=lambda s: s["key"]):
            a = allow.get(s["key"], dict(kind="?", reason=""))
            out.append(f"{s['key']} | {a['kind']} | {a['reason']}")
        allow_path.write_text("\n".join(out) + "\n")
        print(f"wrote {len(sites)} timers to {allow_path} ({len(unknown)} to classify)")
        return 0

    if args.json:
        for s in sites:
            s.update(allow.get(s["key"], dict(kind="?", reason="")))
        Path(args.json).write_text(json.dumps(sites, indent=1))

    counts = [f"{k} {len(v)}" for k, v in sorted(by_kind.items(), key=lambda kv: -len(kv[1]))]
    print(f"{len(sites)} timers: " + ", ".join(counts + ([f"unclassified {len(unknown)}"] if unknown else [])))
    for s in by_kind.get("poll", []):
        print(f"  POLL {s['file']}:{s['line']} {s['function']}: {allow[s['key']]['reason']}")
    for s in unknown[: args.show]:
        print(f"  UNCLASSIFIED {s['file']}:{s['line']} {s['function']} {s['call']}")
    if len(unknown) > args.show:
        print(f"  ... {len(unknown) - args.show} more unclassified")
    for s, k in bad:
        print(f"  UNKNOWN KIND {k!r}: {s['key']}")
    for k in stale:
        print(f"  stale entry (no longer in the code): {k}")

    failed = bool(unknown or bad)
    if args.base and (Path(args.base) / args.allow).exists():
        base = Path(args.base).resolve()
        old = {k for k, a in read_allow(base / args.allow).items() if a["kind"] == "poll"}
        new = [s for s in by_kind.get("poll", []) if s["key"] not in old]
        for s in new:
            print(f"  NEW POLL {s['file']}:{s['line']} {s['function']}")
        failed = failed or bool(new)
    return 1 if (failed and args.check) else 0


def main():
    ap = argparse.ArgumentParser(prog="depgraph", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("scan"); s.add_argument("root"); s.add_argument("--tree", action="append", default=[])
    s.add_argument("--depth", type=int); s.add_argument("--cuts", type=int, default=5)
    s.add_argument("--json"); s.add_argument("--draw"); s.add_argument("--all", action="store_true")
    d = sub.add_parser("diff"); d.add_argument("base"); d.add_argument("branch")
    d.add_argument("--tree", action="append", default=[]); d.add_argument("--depth", type=int)
    g = sub.add_parser("draw"); g.add_argument("graph"); g.add_argument("out"); g.add_argument("--title")
    r = sub.add_parser("structs"); r.add_argument("root"); r.add_argument("--tree", action="append", default=[])
    r.add_argument("--json"); r.add_argument("--draw")
    t = sub.add_parser("timers"); t.add_argument("root"); t.add_argument("--tree", action="append", default=[])
    t.add_argument("--allow", default=".timers"); t.add_argument("--write", action="store_true")
    t.add_argument("--check", action="store_true"); t.add_argument("--base"); t.add_argument("--json")
    t.add_argument("--show", type=int, default=20)
    args = ap.parse_args()
    sys.exit({"scan": scan, "diff": diff, "draw": draw, "structs": structs, "timers": timers}[args.cmd](args))


if __name__ == "__main__":
    main()
