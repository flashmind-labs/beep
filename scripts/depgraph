def draw(args):
    draw_graph(json.loads(Path(args.graph).read_text()), Path(args.out), args.title)
    return 0


# ---------- timers ----------

TIMER_CALLS = {
    "rust": re.compile(r"\b(?:thread::sleep|interval_at|interval|sleep_until|sleep)\s*\("),
    "ts": re.compile(r"\b(?:setInterval|setTimeout)\s*\("),
    "py": re.compile(r"\b(?:time\.sleep|asyncio\.sleep)\s*\("),
}
FN_DEF = {
    "rust": re.compile(r"^\s*(?:pub(?:\([^)]*\))?\s+)?(?:const\s+)?(?:async\s+)?(?:unsafe\s+)?fn\s+(\w+)"),
    "ts": re.compile(r"^\s*(?:export\s+)?(?:default\s+)?(?:async\s+)?function\s*\*?\s*(\w+)|^\s*(?:export\s+)?(?:const|let|var)\s+(\w+)\s*(?::[^=]+)?=\s*(?:async\s*)?(?:\(|\w+\s*=>|function)|^\s*(?:public\s+|private\s+|protected\s+|static\s+|async\s+|readonly\s+)*(\w+)\s*\([^;]*\)\s*(?::[^{]+)?\{\s*$"),
    "py": re.compile(r"^\s*(?:async\s+)?def\s+(\w+)"),
}
KINDS = {
    "poll": "rereads state the codebase owns on a timer: a defect to replace with a push",
    "retry": "tries a failed connection or call again",
    "debounce": "waits for a burst of events to settle before acting once",
    "deadline": "bounds how long something may take",
    "outside": "reads a source that cannot push (OS, CLI, forge, device tools)",
    "ui": "animation, focus, layout or another user interface timing",
    "pace": "spaces out work on purpose, such as a rate limit or a batch window",
    "compat": "asks an older peer that cannot push; remove once those versions are gone",
}
KEYWORDS = {"if", "for", "while", "switch", "catch", "return", "match", "loop", "else", "with", "new"}
NOT_CODE = re.compile(r"^\s*(?://|#|\*|/\*)")


def timer_files(root: Path, lang: str):
    pattern = {"rust": ["*.rs"], "ts": ["*" + e for e in TS_EXT], "py": ["*.py"]}[lang]
    for p in pattern:
        for f in walk(root, p):
            rel = f.relative_to(root).parts
            if "tests" in rel or "test" in rel or re.search(r"\.(spec|test)\.\w+$|_test\.py$|^test_", f.name):
                continue
            yield f


def timer_sites(repo: Path, trees):
    """Every timer call outside tests: (key, file, line, function, call, context)."""
    sites = []
    for lang, tree in trees:
        for f in sorted(timer_files(tree, lang)):
            text = f.read_text(errors="replace")
            if lang == "rust":
                text = text.split("#[cfg(test)]")[0]
            lines = text.splitlines()
            fn, seen = "<top>", {}
            for i, line in enumerate(lines):
                m = FN_DEF[lang].match(line)
                name = next((g for g in m.groups() if g), None) if m else None
                if name and name not in KEYWORDS:
                    fn = name
                if NOT_CODE.match(line):
                    continue
                for c in TIMER_CALLS[lang].finditer(line):
                    if re.search(r"(?:\bfn|\bfunction|\bdef)\s+$", line[: c.start()]):
                        continue
                    call = c.group(0).rstrip("( ").split("::")[-1].split(".")[-1]
                    path = f.relative_to(repo).as_posix()
                    n = seen[(fn, call)] = seen.get((fn, call), 0) + 1
                    key = f"{path} | {fn} | {call}#{n}"
                    ctx = "\n".join(lines[max(0, i - 3): i + 5])
                    sites.append(dict(key=key, file=path, line=i + 1, function=fn, call=call, context=ctx))
    return sites


def read_allow(path: Path):
    allow = {}
    if not path.exists():
        return allow
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = [p.strip() for p in line.split("|")]
        if len(parts) < 5:
            continue
        key = " | ".join(parts[:3])
        allow[key] = dict(kind=parts[3], reason=" | ".join(parts[4:]))
    return allow


def timers(args):
    root = Path(args.root).resolve()
    sites = timer_sites(root, selected(root, args.tree))
    allow_path = root / args.allow
    allow = read_allow(allow_path)
    keys = {s["key"] for s in sites}
    by_kind, unknown, bad = {}, [], []
    for s in sites:
        a = allow.get(s["key"])
        if a is None or a["kind"] == "?":
            unknown.append(s)
        elif a["kind"] not in KINDS:
            bad.append((s, a["kind"]))
        else:
            by_kind.setdefault(a["kind"], []).append(s)
    stale = sorted(k for k in allow if k not in keys)

    if args.write:
        out = ["# Every timer and sleep outside tests, with what it is for. Kept by `depgraph timers`.",
               "# path | function | call#n | kind | reason",
               "# kinds: " + ", ".join(KINDS), ""]
        for s in sorted(sites, key=lambda s: s["key"]):
            a = allow.get(s["key"], dict(kind="?", reason=""))
            out.append(f"{s['key']} | {a['kind']} | {a['reason']}")
        allow_path.write_text("\n".join(out) + "\n")
        print(f"wrote {len(sites)} timers to {allow_path} ({len(unknown)} to classify)")
        return 0

    if args.json:
        for s in sites:
            s.update(allow.get(s["key"], dict(kind="?", reason="")))
        Path(args.json).write_text(json.dumps(sites, indent=1))

    counts = [f"{k} {len(v)}" for k, v in sorted(by_kind.items(), key=lambda kv: -len(kv[1]))]
    print(f"{len(sites)} timers: " + ", ".join(counts + ([f"unclassified {len(unknown)}"] if unknown else [])))
    for s in by_kind.get("poll", []):
        print(f"  POLL {s['file']}:{s['line']} {s['function']}: {allow[s['key']]['reason']}")
    for s in unknown[: args.show]:
        print(f"  UNCLASSIFIED {s['file']}:{s['line']} {s['function']} {s['call']}")
    if len(unknown) > args.show:
        print(f"  ... {len(unknown) - args.show} more unclassified")
    for s, k in bad:
        print(f"  UNKNOWN KIND {k!r}: {s['key']}")
    for k in stale:
        print(f"  stale entry (no longer in the code): {k}")

    failed = bool(unknown or bad)
    if args.base and (Path(args.base) / args.allow).exists():
        base = Path(args.base).resolve()
        old = {k for k, a in read_allow(base / args.allow).items() if a["kind"] == "poll"}
        new = [s for s in by_kind.get("poll", []) if s["key"] not in old]
        for s in new:
            print(f"  NEW POLL {s['file']}:{s['line']} {s['function']}")
        failed = failed or bool(new)
    return 1 if (failed and args.check) else 0


def main():
    ap = argparse.ArgumentParser(prog="depgraph", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("scan"); s.add_argument("root"); s.add_argument("--tree", action="append", default=[])
    s.add_argument("--depth", type=int); s.add_argument("--cuts", type=int, default=5)
    s.add_argument("--json"); s.add_argument("--draw"); s.add_argument("--all", action="store_true")
    d = sub.add_parser("diff"); d.add_argument("base"); d.add_argument("branch")
    d.add_argument("--tree", action="append", default=[]); d.add_argument("--depth", type=int)
    g = sub.add_parser("draw"); g.add_argument("graph"); g.add_argument("out"); g.add_argument("--title")
    t = sub.add_parser("timers"); t.add_argument("root"); t.add_argument("--tree", action="append", default=[])
    t.add_argument("--allow", default=".timers"); t.add_argument("--write", action="store_true")
    t.add_argument("--check", action="store_true"); t.add_argument("--base"); t.add_argument("--json")
    t.add_argument("--show", type=int, default=20)
    args = ap.parse_args()
    sys.exit({"scan": scan, "diff": diff, "draw": draw, "timers": timers}[args.cmd](args))


if __name__ == "__main__":
    main()
