#!/usr/bin/env python3
"""Module dependency graphs: find cycles, check a branch adds none, draw graphs.

  depgraph scan <root> [--tree PATH]... [--depth N] [--cuts N] [--json OUT] [--draw OUT.html] [--all]
      Reads every Rust crate (src/ beside a Cargo.toml), TypeScript or JavaScript
      tree (src/ beside a package.json) and Python package under <root>, or only
      the given --tree paths. Prints each tree's cycle groups, the imports that
      tie each group and the fewest imports to cut to break it. --json writes the
      graph in the draw format. --draw draws the modules in cycles (--all: every
      module) top to bottom.

  depgraph diff <base checkout> <branch checkout> [--tree PATH]... [--depth N]
      The cycles the branch adds over the base and the imports that close them.
      Exit code 1 when it adds one.

  depgraph draw <graph.json> <out.html> [--title TEXT]
      Draws any graph top to bottom: an entity sits above what it acts on, a
      chain stacks in one column, and the edges that close a cycle run upward,
      outlined in red. Input:
        {"title": "...",
         "nodes": [{"id": "A1", "name": "Session store", "group": "node",
                    "kind": "actor|store|lock|module|stateless", "note": "..."}],
         "edges": [{"from": "A1", "to": "B2", "kind": "push|ping|ask|order|owns|import",
                    "label": "what flows (file:line)", "cut": false}]}
      "cut": true draws the edge as a proposed cut.
      Layout uses elkjs, installed with npm into ~/.cache/depgraph on first use.

  depgraph timers <root> [--allow .timers] [--write] [--check] [--base CHECKOUT] [--json OUT]
      Every timer and sleep outside tests, checked against the allow file at
      <root>: `path | function | call#n | kind | reason`, kind one of poll,
      retry, debounce, deadline, outside, ui, pace, compat. --write adds new timers as
      `?` and drops stale ones. --check exits 1 on a timer with no kind, and with
      --base on a poll the base checkout did not have.

scan and diff check two levels: areas (top folders or modules) and files.
--depth N checks one level, grouping N path segments deep (Python is per file).
A Rust parent and its children count like any two modules; a `pub use`
re-export is naming, so a path through it counts toward the defining module.
Dynamic `import()` counts: a lazy import still closes a cycle at run time.
Type-only TypeScript imports, Rust tests and `#[cfg(test)]` code are left
out. Callbacks, slots and registries that call back up are invisible here:
look for them by hand.
"""
import argparse, html, json, os, re, subprocess, sys
from pathlib import Path

SKIP = {"target", "node_modules", ".git", ".worktrees", "dist", "build", "gen", "__pycache__", ".venv", "venv"}


# ---------- reading imports ----------

def walk(root: Path, pattern: str):
    for dirpath, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if d not in SKIP and not d.startswith(".")]
        for f in files:
            if Path(f).match(pattern):
                yield Path(dirpath) / f


def expand(tree: str):
    """`a::{b, c::{d, e}}` as flat paths."""
    tree = tree.strip()
    at = tree.find("{")
    if at < 0:
        return [tree.split(" as ")[0].strip()] if tree else []
    depth, end = 0, len(tree)
    for i in range(at, len(tree)):
        depth += tree[i] == "{"
        depth -= tree[i] == "}"
        if depth == 0:
            end = i
            break
    parts, depth, start = [], 0, at + 1
    for i in range(at + 1, end):
        depth += tree[i] == "{"
        depth -= tree[i] == "}"
        if tree[i] == "," and depth == 0:
            parts.append(tree[start:i])
            start = i + 1
    parts.append(tree[start:end])
    return [tree[:at] + path for part in parts for path in expand(part)]


def rust_module(root: Path, f: Path):
    parts = list(f.relative_to(root).with_suffix("").parts)
    if parts and parts[-1] in ("mod", "lib", "main"):
        parts.pop()
    return tuple(parts)


RUST_PATH = r"(?<![\w:])(?:crate|self|(?:super::)*super|[a-z_][a-z0-9_]*)(?:::[A-Za-z_][A-Za-z0-9_]*)+"
REEXPORT = r"\bpub(?:\([^)]*\))?\s+use\s+([^;]+);"


def rust_resolve(path: str, here: tuple, mods: set, reexports: dict):
    """The module a path names, following `pub use` re-exports to where an item lives."""
    names = [n.strip() for n in path.split(" as ")[0].split("::")]
    if names[0] == "crate":
        at, tail = (), names[1:]
    elif names[0] == "super":
        ups = len([n for n in names if n == "super"])
        at, tail = here[: max(0, len(here) - ups)], names[ups:]
    elif names[0] == "self":
        at, tail = here, names[1:]
    elif here + (names[0],) in mods:
        at, tail = here, names
    else:
        return None
    for name in tail:
        if at + (name,) in mods:
            at += (name,)
        elif name in reexports.get(at, {}):
            at = reexports[at][name]
        else:
            break
    return at


def rust_edges(root: Path, depth: int):
    """Imports between modules, parent and child included. A `pub use` is naming, not use:
    it adds no edge, and a path through it counts toward the module that defines the item."""
    files = [f for f in walk(root, "*.rs") if "tests" not in f.relative_to(root).parts]
    mods = {rust_module(root, f) for f in files}
    texts = {}
    for f in files:
        text = re.sub(r"//[^\n]*", "", f.read_text(errors="replace")).split("#[cfg(test)]")[0]
        texts[rust_module(root, f)] = text
    reexports = {}
    for _ in range(3):
        for here, text in texts.items():
            for m in re.finditer(REEXPORT, text):
                for path in expand(re.sub(r"\s+", " ", m.group(1))):
                    item = path.split(" as ")[-1].split("::")[-1].strip()
                    to = rust_resolve(path.rsplit("::", 1)[0] if "::" in path else path, here, mods, reexports)
                    if to and to != here and item not in ("*", "self"):
                        reexports.setdefault(here, {})[item] = to
    edges = set()
    for here, text in texts.items():
        text = re.sub(REEXPORT, "", text)
        paths = [m.group(0) for m in re.finditer(RUST_PATH, text)]
        for m in re.finditer(r"\buse\s+([^;]*\{[^;]*);", text):
            paths += expand(re.sub(r"\s+", " ", m.group(1)))
        for path in paths:
            at = rust_resolve(path, here, mods, reexports)
            if at is None:
                continue
            a, b = here[:depth], at[:depth]
            if a and b and a != b:
                edges.add(("::".join(a), "::".join(b)))
    return edges


TS_EXT = (".ts", ".tsx", ".mts", ".js", ".jsx", ".mjs")


def ts_edges(root: Path, depth: int):
    files = {f.resolve() for ext in TS_EXT for f in walk(root, "*" + ext) if not f.name.endswith(".d.ts")}
    base = root.resolve()
    edges = set()
    pattern = (r"^\s*(?:import|export)\s+(?!type\b)[^;]*?from\s+[\"'](\.[^\"']+)[\"']|^\s*import\s+[\"'](\.[^\"']+)[\"']"
               r"|\bimport\(\s*[\"'](\.[^\"']+)[\"']\s*\)")

    def unit(path: Path):
        parts = path.relative_to(base).parts
        return "/".join(parts[:depth]) if len(parts) > depth else "/".join(parts)

    for f in files:
        for m in re.finditer(pattern, f.read_text(errors="replace"), re.M | re.S):
            target = (f.parent / (m.group(1) or m.group(2) or m.group(3))).resolve()
            stem = target.with_suffix("") if target.suffix in (".js", ".mjs", ".jsx") else target
            cands = [target] + [Path(str(stem) + e) for e in TS_EXT] + [target / ("index" + e) for e in TS_EXT]
            for c in cands:
                if c in files and c != f:
                    if unit(f) != unit(c):
                        edges.add((unit(f), unit(c)))
                    break
    return edges


def py_edges(root: Path, _depth: int):
    files = [f for f in walk(root, "*.py")]
    mods = {}
    for f in files:
        parts = list(f.relative_to(root).with_suffix("").parts)
        if parts[-1] == "__init__":
            parts.pop()
        if parts:
            mods[".".join(parts)] = f
    edges = set()
    for name, f in mods.items():
        pkg = name.split(".") if f.name == "__init__.py" else name.split(".")[:-1]
        text = f.read_text(errors="replace")
        targets = []
        for m in re.finditer(r"^\s*from\s+(\.*)([\w.]*)\s+import\s+([^\n#]+)", text, re.M):
            dots, mod, names = m.groups()
            if dots:
                head = pkg[: len(pkg) - (len(dots) - 1)] if len(dots) > 1 else pkg
                full = ".".join(head + ([mod] if mod else []))
            else:
                full = mod
            targets.append(full)
            targets += [f"{full}.{n.strip().split(' as ')[0]}" for n in names.strip("()").split(",") if n.strip()]
        for m in re.finditer(r"^\s*import\s+([\w.]+)", text, re.M):
            targets.append(m.group(1))
        for t in targets:
            while t and t not in mods:
                t = t.rpartition(".")[0]
            if t and t != name and not name.startswith(t + "."):
                edges.add((name, t))
    return edges


READERS = {"rust": rust_edges, "ts": ts_edges, "py": py_edges}


def find_trees(root: Path):
    trees = []
    for cargo in walk(root, "Cargo.toml"):
        if (cargo.parent / "src").is_dir():
            trees.append(("rust", cargo.parent / "src"))
    for pkg in walk(root, "package.json"):
        src = pkg.parent / "src"
        if src.is_dir() and any(True for e in TS_EXT for _ in walk(src, "*" + e)):
            trees.append(("ts", src))
    rust_ts = {t for _, t in trees}
    for init in walk(root, "__init__.py"):
        top = init.parent
        if (top.parent / "__init__.py").exists() or any(top.is_relative_to(t) for t in rust_ts):
            continue
        trees.append(("py", top.parent if top.parent != root else top))
    seen, out = set(), []
    for lang, t in trees:
        if t not in seen:
            seen.add(t)
            out.append((lang, t))
    return out


def tree_lang(path: Path):
    if any(True for _ in walk(path, "*.rs")):
        return "rust"
    if any(True for e in TS_EXT for _ in walk(path, "*" + e)):
        return "ts"
    return "py"


# ---------- cycles ----------

def components(edges):
    graph = {}
    for a, b in edges:
        graph.setdefault(a, []).append(b)
        graph.setdefault(b, [])
    index, low, on, stack, comp, n = {}, {}, set(), [], {}, 0
    for start in graph:
        if start in index:
            continue
        work = [(start, iter(graph[start]))]
        index[start] = low[start] = n; n += 1; stack.append(start); on.add(start)
        while work:
            v, it = work[-1]
            w = next(it, None)
            if w is not None:
                if w not in index:
                    index[w] = low[w] = n; n += 1; stack.append(w); on.add(w)
                    work.append((w, iter(graph[w])))
                elif w in on:
                    low[v] = min(low[v], index[w])
                continue
            work.pop()
            if work:
                low[work[-1][0]] = min(low[work[-1][0]], low[v])
            if low[v] == index[v]:
                group = []
                while True:
                    w = stack.pop(); on.discard(w); group.append(w)
                    if w == v:
                        break
                members = frozenset(group)
                for w in group:
                    comp[w] = members
    return comp


def groups(edges):
    return sorted({g for g in components(edges).values() if len(g) > 1}, key=len, reverse=True)


def in_cycles(edges):
    return sum(len(g) for g in groups(edges))


def cuts(edges, limit):
    """Greedy: the import whose removal frees the most modules, repeated."""
    edges, out, cur = set(edges), [], in_cycles(edges)
    for _ in range(limit):
        comp = components(edges)
        inside = [e for e in edges if len(comp[e[0]]) > 1 and comp[e[0]] is comp[e[1]]]
        if not inside:
            break
        best = min(inside, key=lambda e: in_cycles(edges - {e}))
        after = in_cycles(edges - {best})
        if after >= cur:
            break
        edges.discard(best)
        out.append((best, cur, after))
        cur = after
    return out


# ---------- commands ----------

def selected(root: Path, trees):
    if trees:
        return [(tree_lang(root / t), root / t) for t in trees]
    return find_trees(root)


LEVELS = {"areas": 1, "files": 99}


def levels(args):
    return [(f"depth {args.depth}", args.depth)] if args.depth else list(LEVELS.items())


def scan(args):
    root = Path(args.root).resolve()
    graph = dict(title=f"Module cycles in {root.name}", nodes=[], edges=[])
    for n, (level, depth) in enumerate(levels(args)):
        for lang, tree in selected(root, args.tree):
            edges = READERS[lang](tree, depth)
            gs = groups(edges)
            rel = tree.relative_to(root).as_posix() if tree != root else "."
            print(f"{rel} ({lang}, {level}): {len({x for e in edges for x in e})} modules, {len(edges)} imports, "
                  f"{sum(len(g) for g in gs)} modules in {len(gs)} cycle groups")
            for g in gs:
                print(f"  group of {len(g)}: {', '.join(sorted(g)[:12])}{' ...' if len(g) > 12 else ''}")
            cut = set()
            if gs and args.cuts:
                for (a, b), before, after in cuts(edges, args.cuts):
                    cut.add((a, b))
                    print(f"  cut {a} -> {b}: {before} -> {after} modules in cycles")
            if n:
                continue
            keep = {x for g in gs for x in g} if not args.all else {x for e in edges for x in e}
            for m in sorted(keep):
                graph["nodes"].append(dict(id=f"{rel}:{m}", name=m, group=rel, kind="module", note=""))
            for a, b in sorted(edges):
                if a in keep and b in keep:
                    graph["edges"].append({"from": f"{rel}:{a}", "to": f"{rel}:{b}", "kind": "import", "label": "", "cut": (a, b) in cut})
    if args.json:
        Path(args.json).write_text(json.dumps(graph, indent=1))
    if args.draw:
        draw_graph(graph, Path(args.draw))
    return 0


def diff(args):
    base, branch = Path(args.base).resolve(), Path(args.branch).resolve()
    bad = False
    for level, depth in levels(args):
        for lang, tree in selected(branch, args.tree):
            rel = tree.relative_to(branch)
            old = READERS[lang](base / rel, depth) if (base / rel).is_dir() else set()
            new = READERS[lang](tree, depth)
            was, now = components(old), components(new)
            added = sorted(new - old)
            tying = [(a, b) for a, b in added if len(now[a]) > 1 and now[a] is now[b]
                     and (a not in was or b not in was or was[a] is not was[b])]
            print(f"{rel.as_posix()} ({level}): {in_cycles(old)} modules in cycles before, {in_cycles(new)} now, {len(added)} imports added")
            for a, b in tying:
                bad = True
                print(f"  NEW CYCLE: {a} -> {b} (group of {len(now[a])})")
    return 1 if bad else 0


LAYOUT_JS = r"""
const ELK = (await import(process.argv[2])).default;
const fs = await import("node:fs");
const g = JSON.parse(fs.readFileSync(0, "utf8"));
const out = await new ELK().layout({
  id: "root",
  layoutOptions: {
    "elk.algorithm": "layered", "elk.direction": "DOWN", "elk.edgeRouting": "SPLINES",
    "elk.layered.spacing.nodeNodeBetweenLayers": "70", "elk.spacing.nodeNode": "28",
    "elk.layered.spacing.edgeNodeBetweenLayers": "18", "elk.spacing.edgeEdge": "8",
    "elk.layered.nodePlacement.strategy": "NETWORK_SIMPLEX",
    "elk.layered.cycleBreaking.strategy": "GREEDY",
    "elk.layered.thoroughness": "40", "elk.spacing.componentComponent": "60",
  },
  children: g.nodes, edges: g.edges,
});
process.stdout.write(JSON.stringify(out));
"""


def elk():
    cache = Path.home() / ".cache" / "depgraph"
    lib = cache / "node_modules" / "elkjs" / "lib" / "elk.bundled.js"
    if not lib.exists():
        cache.mkdir(parents=True, exist_ok=True)
        subprocess.run(["npm", "install", "--silent", "--prefix", str(cache), "elkjs@latest"], check=True)
    script = cache / "layout.mjs"
    if not script.exists() or script.read_text() != LAYOUT_JS:
        script.write_text(LAYOUT_JS)
    return script, lib


KIND_COLOR = {"push": "#4fc38a", "ping": "#e0a93a", "ask": "#e8675a", "order": "#5aa2ef", "owns": "#9aa0a8", "import": "#7f8ea3"}
KIND_DASH = {"ping": "5 4", "owns": "1 4"}
KIND_TEXT = {"push": "sends the value", "ping": "signal, reader then reads", "ask": "request and answer",
             "order": "call that sequences work", "owns": "owns", "import": "imports"}
NODE_COLOR = {"actor": "#4fc38a", "store": "#5aa2ef", "lock": "#e0a93a", "module": "#a98bf0", "stateless": "#6b7079"}
GROUP_TINT = ["#1a1f1c", "#1b1d22", "#211c1b", "#1d1b22", "#1f1e19", "#1a2022"]


def draw_graph(graph, out: Path, title=None):
    nodes = graph["nodes"]
    ids = {n["id"] for n in nodes}
    edges = [e for e in graph["edges"] if e["from"] in ids and e["to"] in ids and e["from"] != e["to"]]
    comp = components({(e["from"], e["to"]) for e in edges if e.get("kind") != "owns"})
    cyc = lambda a, b: a in comp and len(comp[a]) > 1 and comp[a] is comp.get(b)
    width = 210
    lines = lambda s, n: max(1, -(-len(s.replace("`", "")) // n))
    heights = {n["id"]: 16 + 16 * lines(n.get("name", n["id"]), 26) + (13 * min(4, lines(n["note"], 33)) if n.get("note") else 0) + 18 for n in nodes}
    script, lib = elk()
    request = dict(nodes=[dict(id=n["id"], width=width, height=heights[n["id"]]) for n in nodes],
                   edges=[dict(id=f"e{i}", sources=[e["from"]], targets=[e["to"]]) for i, e in enumerate(edges)])
    laid = json.loads(subprocess.run(["node", str(script), str(lib)], input=json.dumps(request), text=True,
                                     capture_output=True, check=True).stdout)
    pos = {c["id"]: c for c in laid["children"]}
    pad = 20
    gw, gh = laid["width"] + 2 * pad, laid["height"] + 2 * pad
    esc = lambda s: html.escape(str(s))
    tx = lambda s: re.sub(r"`([^`]+)`", r"<code>\1</code>", esc(s))
    tints = {g: GROUP_TINT[i % len(GROUP_TINT)] for i, g in enumerate(dict.fromkeys(n.get("group", "") for n in nodes))}

    def path(sec):
        p = [sec["startPoint"], *sec.get("bendPoints", []), sec["endPoint"]]
        p = [f"{q['x'] + pad:.1f},{q['y'] + pad:.1f}" for q in p]
        if len(p) > 2 and (len(p) - 1) % 3 == 0:
            return f"M{p[0]}" + "".join(f" C{p[i]} {p[i + 1]} {p[i + 2]}" for i in range(1, len(p), 3))
        return "M" + " L".join(p)

    svg = []
    for le, e in zip(laid["edges"], edges):
        k = e.get("kind", "import")
        if not le.get("sections"):
            continue
        up = pos[e["to"]]["y"] < pos[e["from"]]["y"]
        cls = "e" + (" cyc" if up and k != "owns" and cyc(e["from"], e["to"]) else "") + (" cut" if e.get("cut") else "")
        tip = f"{e['from']} to {e['to']}: {k}" + (f", {e['label']}" if e.get("label") else "") + (" (closes a cycle)" if up else "") + (" (suggested cut)" if e.get("cut") else "")
        svg.append(f'<path class="{cls}" data-a="{esc(e["from"])}" data-b="{esc(e["to"])}" d="{path(le["sections"][0])}" '
                   f'stroke="{KIND_COLOR.get(k, "#7f8ea3")}" stroke-dasharray="{KIND_DASH.get(k, "")}" marker-end="url(#m-{k})"><title>{esc(tip.replace("`", ""))}</title></path>')
    boxes = []
    for n in nodes:
        p = pos[n["id"]]
        c = " cyc" if n["id"] in comp and len(comp[n["id"]]) > 1 else ""
        boxes.append(f'<div class="n{c}" id="{esc(n["id"])}" style="left:{p["x"] + pad:.0f}px;top:{p["y"] + pad:.0f}px;width:{width}px;height:{p["height"]:.0f}px;'
                     f'border-color:{NODE_COLOR.get(n.get("kind", "module"), "#a98bf0")};background:{tints[n.get("group", "")]}">'
                     f'<i>{esc(n.get("group", ""))}</i><b>{tx(n.get("name", n["id"]))}</b>{f"<span>{tx(n["note"])}</span>" if n.get("note") else ""}</div>')
    kinds = sorted({e.get("kind", "import") for e in edges}, key=list(KIND_COLOR).index)
    markers = "".join(f'<marker id="m-{k}" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="{KIND_COLOR[k]}"/></marker>' for k in kinds)
    legend = "".join(f'<span><i class="ln" style="border-color:{KIND_COLOR[k]};border-top-style:{"dashed" if k == "ping" else "dotted" if k == "owns" else "solid"}"></i>{k}: {KIND_TEXT[k]} ({sum(1 for e in edges if e.get("kind", "import") == k)})</span>' for k in kinds)
    legend += "".join(f'<span><i class="sw" style="background:{c}"></i>{k}</span>' for k, c in NODE_COLOR.items() if any(n.get("kind") == k for n in nodes))
    in_cyc = sum(1 for n in nodes if n["id"] in comp and len(comp[n["id"]]) > 1)
    title = title or graph.get("title", "Dependency graph")
    out.write_text(f"""<!doctype html><html><head><meta charset="utf-8"><title>{esc(title)}</title><style>
body{{margin:0;background:#0e0f11;color:#d8dade;font:13px/1.4 -apple-system,system-ui,sans-serif}}
header{{padding:18px 22px 6px}}h1{{font-size:20px;margin:0 0 4px}}.meta{{font:11px ui-monospace,monospace;color:#8a8f98}}
p{{max-width:900px;color:#b8bcc4;margin:8px 0}}
.lg{{display:flex;flex-wrap:wrap;gap:14px;font:11px ui-monospace,monospace;color:#8a8f98;margin:8px 0}}.lg span{{display:inline-flex;align-items:center;gap:6px}}
.sw{{width:10px;height:10px;display:inline-block}}.ln{{width:22px;height:0;border-top:2px solid;display:inline-block}}
#fit{{margin:0 22px;font:11px ui-monospace,monospace;background:#22252b;color:#d8dade;border:1px solid #333;padding:4px 10px;cursor:pointer}}
.wrap{{position:relative;margin:10px 0 0}}svg{{position:absolute;left:0;top:0;overflow:visible}}
.e{{fill:none;stroke-width:1.4;opacity:.8}}.e.cyc{{stroke-width:2.8;opacity:1;filter:drop-shadow(0 0 3px #ff4d6d)}}.e.cut{{stroke:#ff4d6d;stroke-width:3;stroke-dasharray:8 5;opacity:1}}
.n{{position:absolute;box-sizing:border-box;border-left:3px solid;padding:6px 9px;overflow:hidden}}
.n i{{display:block;font:9px ui-monospace,monospace;font-style:normal;text-transform:uppercase;letter-spacing:.06em;color:#8a8f98;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}}
.n b{{display:block;font-size:12.5px;color:#fff;overflow-wrap:anywhere}}.n span{{display:block;font-size:11px;color:#8a8f98;line-height:1.3}}
.n code{{font:10.5px ui-monospace,monospace;color:#c9cdd4}}.n.cyc{{outline:1.5px solid #ff4d6d;outline-offset:2px}}
