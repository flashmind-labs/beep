# Every setting of the bundle. ./setup.sh writes .env from this file: it
# generates the secrets, asks for the API keys and takes any setting below
# from the environment. Empty keeps the default.

# Postgres password; setup.sh generates it. Letters and digits only: it goes
# into a URL. Changing it after the first start locks the server out.
POSTGRES_PASSWORD=

# Images. Leave empty to build them from this checkout with
# `docker compose build`, or name images from your registry.
BEEP_SERVER_IMAGE=
BEEP_NODE_IMAGE=

# OpenRouter key (sk-or-v1-...). Every model below goes through it; the
# server does not start without it.
BEEP_PROVIDER_KEY=
# The assistant's model. Default: openrouter:z-ai/glm-5.3-flash
BEEP_MODEL=
# Describes images for a model without vision.
BEEP_VISION_MODEL=
# How much the model thinks: off, low, medium or high. Default: low
BEEP_REASONING=

# Optional services.
BEEP_FIRECRAWL_KEY=
BEEP_OPENAI_KEY=
BEEP_MISTRAL_KEY=
BEEP_COMPOSIO_KEY=
BEEP_COMPOSIO_CALLBACK_URL=beep://apps/connected

# The owner: the endpoint id of the phone that may claim this server. Empty
# lets the first phone that connects claim it.
BEEP_OWNER=
# What the server calls itself in its link code.
BEEP_NAME=Beep
# Features for the owner, true or false. All default to true.
BEEP_EVENTS=true
BEEP_NODES=true
BEEP_AGENTS=true

# What the bundled node is called in the app.
BEEP_NODE_NAME=Beep server

# Push notifications for apps the server cannot reach directly. Put the key
# files in deploy/onprem/local/ and name them here. Without them notices
# reach the apps only while they are connected.
BEEP_FCM_FILE=
BEEP_APNS_FILE=
BEEP_APNS_KEY_ID=
BEEP_APNS_TEAM_ID=
BEEP_APNS_TOPIC=

# A config of your own instead of the one written from this file, such as
# /data/my-config.toml. deploy/onprem/local/extra.toml is added to the
# written one when present.
BEEP_CONFIG=

# Outgoing traffic cap for the server and the node, in bytes per second: a
# number, or one with K, M or G for KiB, MiB or GiB per second. Empty means
# 1M (1 MiB/s). 0 or unlimited turns it off; setup.sh --admin writes that.
BEEP_EGRESS_LIMIT=

# Server log level.
RUST_LOG=info
