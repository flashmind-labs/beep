{
  "id": "hardware-dark",
  "name": "Hardware dark",
  "version": "0.1.0",
  "api": 2,
  "description": "Black anodised metal: square keys, orange readouts, no glass.",
  "permissions": ["style"],
  "activation": [],
  "style": {
    "--ink": "#0a0a0a",
    "--deep": "#050505",
    "--surface": "#101010",
    "--elev": "#181818",
    "--border": "#1e1e1e",
    "--border-hi": "#2e2e2e",
    "--fg": "#ecebe6",
    "--muted": "#8f8c85",
    "--dim": "#7a776f",
    "--accent": "#ff4f00",
    "--on-accent": "#fff",
    "--hot": "#ff7a3d",
    "--ok": "#3ddc84",
    "--err": "#ff6a4d",
    "--warn": "#ffb000",
    "--link": "#ff7a3d",
    "--display": "\"Space Grotesk\", var(--body)",
    "--radius": "4px",
    "--radius-sm": "3px",
    "--label-case": "uppercase",
    "--label-track": ".08em",
    "--label-size": "10px",
    "--glass": "none",
    "--glass-solid": "100%",
    "--paintings": "none"
  }
}
