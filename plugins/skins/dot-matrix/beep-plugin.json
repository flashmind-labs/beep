{
  "id": "dot-matrix",
  "name": "Dot matrix",
  "version": "0.1.0",
  "api": 2,
  "description": "Black, dotted display type, pill controls and one red.",
  "permissions": ["style"],
  "activation": [],
  "style": {
    "--ink": "#000",
    "--deep": "#000",
    "--surface": "#0b0b0b",
    "--elev": "#161616",
    "--border": "#1f1f1f",
    "--border-hi": "#3a3a3a",
    "--fg": "#fff",
    "--muted": "#9a9a9a",
    "--dim": "#7a7a7a",
    "--accent": "#d71921",
    "--on-accent": "#fff",
    "--hot": "#d71921",
    "--ok": "#fff",
    "--err": "#d71921",
    "--warn": "#d71921",
    "--link": "#fff",
    "--display": "Doto, var(--mono)",
    "--radius": "12px",
    "--radius-sm": "999px",
    "--label-case": "uppercase",
    "--label-track": ".1em",
    "--label-size": "10.5px",
    "--glass": "none",
    "--glass-solid": "100%",
    "--paintings": "none"
  }
}
