<?xml version="1.0" encoding="utf-8"?>
<!-- The panel shrinks back into the head. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/accelerate_cubic" android:duration="160">
    <scale android:fromXScale="1" android:toXScale="0.3" android:fromYScale="1" android:toYScale="0.3"
        android:pivotX="92%" android:pivotY="0%" />
    <alpha android:fromAlpha="1" android:toAlpha="0" />
</set>
